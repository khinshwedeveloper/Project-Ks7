@model List<Hotelbooking.Database.Models.TblRoom>

@{
    ViewData["Title"] = "Rooms";

    var roomTypes = ViewBag.RoomTypes as List<Hotelbooking.Database.Models.TblRoomType>
                     ?? new List<Hotelbooking.Database.Models.TblRoomType>();

    int totalRooms = Model.Count;
    int availableRooms = Model.Count(x => x.Status != null && x.Status.StatusName == "Available");
    int reservedRooms = Model.Count(x => x.Status != null && x.Status.StatusName == "Reserved");
    int occupiedRooms = Model.Count(x => x.Status != null && x.Status.StatusName == "Occupied");
    int maintenanceRooms = Model.Count(x => x.Status != null && x.Status.StatusName == "Maintenance");
}

<div class="max-w-7xl mx-auto space-y-8">

    <!-- PAGE HEADER -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-sm text-slate-400 dark:text-slate-400 mb-2">
                <i data-lucide="bed-double" class="w-4 h-4 text-blue-500"></i>
                <span>Room Management</span>
            </div>

            <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
                Rooms
            </h1>

            <p class="text-slate-500 dark:text-slate-400 mt-1">
                Manage hotel rooms, floors, room types and live availability.
            </p>
        </div>

        <a asp-controller="Room"
           asp-action="Create"
           class="inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-5 py-3 rounded-xl font-semibold shadow-lg shadow-blue-600/20 transition">
            <i data-lucide="plus" class="w-5 h-5"></i>
            Add Room
        </a>
    </div>

    <!-- SUMMARY CARDS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- TOTAL -->
        <div class="premium-card p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Total Rooms</p>
                    <h2 class="text-3xl font-bold text-slate-900 dark:text-white mt-2">@totalRooms</h2>
                </div>
                <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-950/60 flex items-center justify-center">
                    <i data-lucide="bed-double" class="w-6 h-6 text-blue-600 dark:text-blue-400"></i>
                </div>
            </div>
        </div>

        <!-- AVAILABLE -->
        <div class="premium-card p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Available</p>
                    <h2 class="text-3xl font-bold text-emerald-600 dark:text-emerald-400 mt-2">@availableRooms</h2>
                </div>
                <div class="w-12 h-12 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 flex items-center justify-center">
                    <i data-lucide="check-circle" class="w-6 h-6 text-emerald-600 dark:text-emerald-400"></i>
                </div>
            </div>
        </div>

        <!-- OCCUPIED -->
        <div class="premium-card p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Occupied</p>
                    <h2 class="text-3xl font-bold text-blue-600 dark:text-blue-400 mt-2">@occupiedRooms</h2>
                </div>
                <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-950/60 flex items-center justify-center">
                    <i data-lucide="door-closed" class="w-6 h-6 text-blue-600 dark:text-blue-400"></i>
                </div>
            </div>
        </div>

        <!-- MAINTENANCE -->
        <div class="premium-card p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Maintenance</p>
                    <h2 class="text-3xl font-bold text-rose-600 dark:text-rose-400 mt-2">@maintenanceRooms</h2>
                </div>
                <div class="w-12 h-12 rounded-xl bg-rose-50 dark:bg-rose-950/60 flex items-center justify-center">
                    <i data-lucide="wrench" class="w-6 h-6 text-rose-600 dark:text-rose-400"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- QUICK STATUS PILLS -->
    <div class="flex flex-wrap items-center gap-3">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 dark:bg-emerald-950/50 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/50 text-xs font-semibold">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            Available: @availableRooms
        </div>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-50 dark:bg-amber-950/50 text-amber-700 dark:text-amber-300 border border-amber-200 dark:border-amber-800/50 text-xs font-semibold">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            Reserved: @reservedRooms
        </div>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/50 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800/50 text-xs font-semibold">
            <span class="w-2 h-2 rounded-full bg-blue-500"></span>
            Occupied: @occupiedRooms
        </div>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-rose-50 dark:bg-rose-950/50 text-rose-700 dark:text-rose-300 border border-rose-200 dark:border-rose-800/50 text-xs font-semibold">
            <span class="w-2 h-2 rounded-full bg-rose-500"></span>
            Maintenance: @maintenanceRooms
        </div>
    </div>

    <!-- ROOM TABLE CARD -->
    <div class="premium-card overflow-hidden">
        <!-- TABLE HEADER -->
        <div class="px-6 py-5 border-b border-slate-100 dark:border-slate-700/60 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
                <h2 class="font-bold text-slate-900 dark:text-white">All Rooms</h2>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">View and manage hotel room inventory.</p>
            </div>

            <!-- SEARCH -->
            <div class="relative">
                <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                <input id="roomSearch"
                       type="text"
                       placeholder="Search room..."
                       class="w-full md:w-72 pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-800 dark:text-white placeholder-slate-400 outline-none focus:ring-2 focus:ring-blue-500 transition" />
            </div>
        </div>

        <!-- TABLE -->
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="bg-slate-50 dark:bg-slate-900/60 text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 border-b border-slate-100 dark:border-slate-700/60">
                        <th class="px-6 py-4 text-left">#</th>
                        <th class="px-6 py-4 text-left">Room</th>
                        <th class="px-6 py-4 text-left">Room Type</th>
                        <th class="px-6 py-4 text-left">Floor</th>
                        <th class="px-6 py-4 text-left">Status</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>

                <tbody id="roomTable" class="divide-y divide-slate-100 dark:divide-slate-700/60">
                    @{
                        int count = 1;
                    }

                    @foreach (var item in Model)
                    {
                        string statusName = item.Status?.StatusName ?? "Unknown";
                        string statusBadgeClass = statusName switch
                        {
                            "Available" => "bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800/60",
                            "Reserved" => "bg-amber-50 dark:bg-amber-900/30 text-amber-700 dark:text-amber-300 border-amber-200 dark:border-amber-800/60",
                            "Occupied" => "bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 border-blue-200 dark:border-blue-800/60",
                            "Maintenance" => "bg-rose-50 dark:bg-rose-900/30 text-rose-700 dark:text-rose-300 border-rose-200 dark:border-rose-800/60",
                            _ => "bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-600"
                        };

                        <tr class="table-row room-row hover:bg-slate-50/80 dark:hover:bg-slate-700/40 transition">
                            <!-- NUMBER -->
                            <td class="px-6 py-5 text-sm text-slate-400 dark:text-slate-500">
                                @count
                            </td>

                            <!-- ROOM -->
                            <td class="px-6 py-5">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/60 flex items-center justify-center">
                                        <i data-lucide="bed-double" class="w-5 h-5 text-blue-600 dark:text-blue-400"></i>
                                    </div>
                                    <div>
                                        <div class="font-semibold text-slate-900 dark:text-white">
                                            Room @item.RoomNo
                                        </div>
                                        <div class="text-xs text-slate-400 dark:text-slate-500">
                                            ID #@item.RoomId
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <!-- ROOM TYPE -->
                            <td class="px-6 py-5">
                                @if (item.RoomType != null)
                                {
                                    <div>
                                        <div class="font-medium text-slate-800 dark:text-slate-200">
                                            @item.RoomType.RoomTypeName
                                        </div>
                                        <div class="text-xs text-slate-400 dark:text-slate-500">
                                            Max: @item.RoomType.MaxGuest Guests
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-sm text-slate-400 dark:text-slate-500">Unknown</span>
                                }
                            </td>

                            <!-- FLOOR -->
                            <td class="px-6 py-5">
                                <div class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
                                    <i data-lucide="layers" class="w-4 h-4 text-slate-400"></i>
                                    @(item.Floor?.FloorName ?? $"Floor {item.FloorId}")
                                </div>
                            </td>

                            <!-- STATUS -->
                            <td class="px-6 py-5">
                                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border text-xs font-semibold @statusBadgeClass">
                                    <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
                                    @statusName
                                </span>
                            </td>

                            <!-- ACTIONS -->
                            <td class="px-6 py-5 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a asp-controller="Room"
                                       asp-action="Edit"
                                       asp-route-id="@item.RoomId"
                                       class="w-9 h-9 rounded-lg bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-300 flex items-center justify-center hover:bg-blue-600 hover:text-white dark:hover:bg-blue-600 dark:hover:text-white transition"
                                       title="Edit Room">
                                        <i data-lucide="pencil" class="w-4 h-4"></i>
                                    </a>

                                    <form asp-controller="Room"
                                          asp-action="Delete"
                                          asp-route-id="@item.RoomId"
                                          method="post"
                                          class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                onclick="return confirm('Are you sure you want to delete this room?')"
                                                class="w-9 h-9 rounded-lg bg-rose-50 dark:bg-rose-900/30 text-rose-600 dark:text-rose-300 flex items-center justify-center hover:bg-rose-600 hover:text-white dark:hover:bg-rose-600 dark:hover:text-white transition"
                                                title="Delete Room">
                                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>

                        count++;
                    }

                    <!-- EMPTY STATE -->
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-16 text-center">
                                <div class="w-16 h-16 mx-auto rounded-2xl bg-slate-100 dark:bg-slate-700 flex items-center justify-center mb-4">
                                    <i data-lucide="bed-double" class="w-7 h-7 text-slate-400"></i>
                                </div>
                                <h3 class="font-bold text-slate-800 dark:text-white">No Rooms</h3>
                                <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 mb-5">Add your first room to get started.</p>
                                <a asp-controller="Room" asp-action="Create" class="inline-flex items-center gap-2 bg-blue-600 text-white px-4 py-2.5 rounded-xl font-medium hover:bg-blue-700">
                                    <i data-lucide="plus" class="w-4 h-4"></i> Add Room
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $("#roomSearch").on("keyup", function () {
            const searchValue = $(this).val().toLowerCase();
            $(".room-row").each(function () {
                const rowText = $(this).text().toLowerCase();
                if (rowText.includes(searchValue)) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        });
    </script>
}