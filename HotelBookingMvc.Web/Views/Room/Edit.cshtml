@model Hotelbooking.Database.Models.TblRoom

@{
    ViewData["Title"] = "Edit Room";

    var roomTypes = ViewBag.RoomTypes as List<Hotelbooking.Database.Models.TblRoomType>
                     ?? new List<Hotelbooking.Database.Models.TblRoomType>();

    var floors = ViewBag.Floors as List<Hotelbooking.Database.Models.TblFloor>
                 ?? new List<Hotelbooking.Database.Models.TblFloor>();

    var statuses = ViewBag.RoomStatuses as List<Hotelbooking.Database.Models.TblRoomStatus>
                   ?? new List<Hotelbooking.Database.Models.TblRoomStatus>();
}

<div class="max-w-5xl mx-auto space-y-6">

    <!-- PAGE HEADER -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-sm text-slate-400 dark:text-slate-400 mb-2">
                <i data-lucide="bed-double" class="w-4 h-4 text-blue-500"></i>
                <a asp-action="Index" class="hover:text-blue-500 transition">Room Management</a>
                <i data-lucide="chevron-right" class="w-4 h-4"></i>
                <span class="text-slate-700 dark:text-slate-200 font-medium">Edit Room</span>
            </div>

            <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
                Edit Room
            </h1>

            <p class="text-slate-500 dark:text-slate-400 mt-1">
                Update room information, floor allocation, and availability.
            </p>
        </div>

        <a asp-controller="Room"
           asp-action="Index"
           class="inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 font-semibold hover:bg-slate-50 dark:hover:bg-slate-700 transition">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Back to Rooms
        </a>
    </div>

    <!-- FORM CARD -->
    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm overflow-hidden">

        <!-- CARD HEADER -->
        <div class="px-6 py-5 border-b border-slate-100 dark:border-slate-700/60 flex items-center gap-4">
            <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-950/60 flex items-center justify-center">
                <i data-lucide="pencil" class="w-6 h-6 text-blue-600 dark:text-blue-400"></i>
            </div>
            <div>
                <h2 class="font-bold text-slate-900 dark:text-white">
                    Room Information
                </h2>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                    Update the details for Room @Model.RoomNo.
                </p>
            </div>
        </div>

        <!-- FORM -->
        <form asp-controller="Room"
              asp-action="Edit"
              method="post"
              class="p-6 sm:p-8 space-y-6">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="RoomId" />

            <!-- VALIDATION -->
            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800/60 text-rose-700 dark:text-rose-300 text-sm"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- ROOM NUMBER -->
                <div>
                    <label asp-for="RoomNo" class="block text-sm font-semibold text-slate-700 dark:text-slate-200 mb-2">
                        Room Number <span class="text-rose-500">*</span>
                    </label>

                    <div class="relative">
                        <i data-lucide="door-open" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400"></i>
                        <input asp-for="RoomNo"
                               type="text"
                               class="w-full pl-11 pr-4 py-3 border border-slate-200 dark:border-slate-600 rounded-xl bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-white outline-none focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-blue-500 transition" />
                    </div>

                    <span asp-validation-for="RoomNo" class="text-sm text-rose-500 mt-1 block"></span>
                </div>

                <!-- ROOM TYPE -->
                <div>
                    <label asp-for="RoomTypeId" class="block text-sm font-semibold text-slate-700 dark:text-slate-200 mb-2">
                        Room Type <span class="text-rose-500">*</span>
                    </label>

                    <select asp-for="RoomTypeId"
                            class="w-full px-4 py-3 border border-slate-200 dark:border-slate-600 rounded-xl bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-white outline-none focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-blue-500 transition">
                        @foreach (var type in roomTypes)
                        {
                            <option value="@type.RoomTypeId">@type.RoomTypeName (@type.MaxGuest Guests)</option>
                        }
                    </select>

                    <span asp-validation-for="RoomTypeId" class="text-sm text-rose-500 mt-1 block"></span>
                </div>

                <!-- FLOOR -->
                <div>
                    <label asp-for="FloorId" class="block text-sm font-semibold text-slate-700 dark:text-slate-200 mb-2">
                        Floor <span class="text-rose-500">*</span>
                    </label>

                    <select asp-for="FloorId"
                            class="w-full px-4 py-3 border border-slate-200 dark:border-slate-600 rounded-xl bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-white outline-none focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-blue-500 transition">
                        @foreach (var floor in floors)
                        {
                            <option value="@floor.FloorId">@floor.FloorName</option>
                        }
                    </select>

                    <span asp-validation-for="FloorId" class="text-sm text-rose-500 mt-1 block"></span>
                </div>

                <!-- STATUS -->
                <div>
                    <label asp-for="StatusId" class="block text-sm font-semibold text-slate-700 dark:text-slate-200 mb-2">
                        Room Status <span class="text-rose-500">*</span>
                    </label>

                    <select asp-for="StatusId"
                            class="w-full px-4 py-3 border border-slate-200 dark:border-slate-600 rounded-xl bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-white outline-none focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-blue-500 transition">
                        @foreach (var status in statuses)
                        {
                            <option value="@status.StatusId">@status.StatusName</option>
                        }
                    </select>

                    <span asp-validation-for="StatusId" class="text-sm text-rose-500 mt-1 block"></span>
                </div>

            </div>

            <!-- BUTTONS -->
            <div class="flex items-center gap-4 pt-4 border-t border-slate-100 dark:border-slate-700/60">
                <button type="submit"
                        class="px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold shadow-sm transition">
                    Update Room
                </button>

                <a asp-action="Index"
                   class="px-6 py-3 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 font-semibold transition">
                    Cancel
                </a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}