@model HotelBookingMvc.Web.ViewModels.BookingCreateViewModel

@{
ViewData["Title"] = "New Booking";
}

<div class="min-h-screen bg-slate-50 p-6">

```
<!-- Header -->
<div class="mb-7">

    <div class="flex items-center gap-2 text-sm text-slate-500 mb-2">

        <a asp-action="Index"
           class="hover:text-slate-900 transition">
            Bookings
        </a>

        <i data-lucide="chevron-right"
           class="w-4 h-4"></i>

        <span>New Booking</span>

    </div>

    <h1 class="text-3xl font-bold text-slate-900">
        Create New Booking
    </h1>

    <p class="text-slate-500 mt-1">
        Create a reservation for your hotel guest.
    </p>

</div>


<form asp-action="Create"
      method="post"
      id="bookingForm">

    @Html.AntiForgeryToken()

    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">


        <!-- LEFT -->
        <div class="xl:col-span-2 space-y-6">


            <!-- Guest Information -->
            <div class="bg-white rounded-2xl
                        border border-slate-200
                        shadow-sm p-6">

                <div class="flex items-center gap-3 mb-6">

                    <div class="w-10 h-10 rounded-xl
                                bg-slate-100
                                flex items-center justify-center">

                        <i data-lucide="user"
                           class="w-5 h-5 text-slate-700"></i>

                    </div>

                    <div>
                        <h2 class="font-bold text-slate-900">
                            Guest Information
                        </h2>

                        <p class="text-sm text-slate-500">
                            Select the customer for this booking.
                        </p>
                    </div>

                </div>


                <label asp-for="CustomerId"
                       class="block text-sm font-semibold
                              text-slate-700 mb-2">

                    Customer

                </label>

                <select asp-for="CustomerId"
                        asp-items="Model.Customers"
                        class="w-full px-4 py-3
                               border border-slate-200
                               rounded-xl bg-white
                               outline-none
                               focus:ring-2
                               focus:ring-slate-300
                               focus:border-slate-400">

                    <option value="">
                        Select customer
                    </option>

                </select>

                <span asp-validation-for="CustomerId"
                      class="text-sm text-red-500">
                </span>

            </div>


            <!-- Stay Information -->
            <div class="bg-white rounded-2xl
                        border border-slate-200
                        shadow-sm p-6">

                <div class="flex items-center gap-3 mb-6">

                    <div class="w-10 h-10 rounded-xl
                                bg-slate-100
                                flex items-center justify-center">

                        <i data-lucide="calendar-range"
                           class="w-5 h-5 text-slate-700"></i>

                    </div>

                    <div>
                        <h2 class="font-bold text-slate-900">
                            Stay Information
                        </h2>

                        <p class="text-sm text-slate-500">
                            Select check-in and check-out dates.
                        </p>
                    </div>

                </div>


                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                    <!-- Check In -->
                    <div>

                        <label asp-for="CheckInDate"
                               class="block text-sm
                                      font-semibold
                                      text-slate-700 mb-2">

                            Check-in Date

                        </label>

                        <input asp-for="CheckInDate"
                               type="date"
                               id="checkInDate"
                               class="w-full px-4 py-3
                                      border border-slate-200
                                      rounded-xl outline-none
                                      focus:ring-2
                                      focus:ring-slate-300" />

                        <span asp-validation-for="CheckInDate"
                              class="text-sm text-red-500">
                        </span>

                    </div>


                    <!-- Check Out -->
                    <div>

                        <label asp-for="CheckOutDate"
                               class="block text-sm
                                      font-semibold
                                      text-slate-700 mb-2">

                            Check-out Date

                        </label>

                        <input asp-for="CheckOutDate"
                               type="date"
                               id="checkOutDate"
                               class="w-full px-4 py-3
                                      border border-slate-200
                                      rounded-xl outline-none
                                      focus:ring-2
                                      focus:ring-slate-300" />

                        <span asp-validation-for="CheckOutDate"
                              class="text-sm text-red-500">
                        </span>

                    </div>

                </div>

            </div>


            <!-- Room -->
            <div class="bg-white rounded-2xl
                        border border-slate-200
                        shadow-sm p-6">

                <div class="flex items-center gap-3 mb-6">

                    <div class="w-10 h-10 rounded-xl
                                bg-slate-100
                                flex items-center justify-center">

                        <i data-lucide="bed-double"
                           class="w-5 h-5 text-slate-700"></i>

                    </div>

                    <div>
                        <h2 class="font-bold text-slate-900">
                            Room Selection
                        </h2>

                        <p class="text-sm text-slate-500">
                            Only available rooms are shown.
                        </p>
                    </div>

                </div>


                <label asp-for="RoomId"
                       class="block text-sm
                              font-semibold
                              text-slate-700 mb-2">

                    Available Room

                </label>

                <select asp-for="RoomId"
                        asp-items="Model.Rooms"
                        id="roomId"
                        class="w-full px-4 py-3
                               border border-slate-200
                               rounded-xl bg-white
                               outline-none
                               focus:ring-2
                               focus:ring-slate-300">

                    <option value="">
                        Select available room
                    </option>

                </select>

                <span asp-validation-for="RoomId"
                      class="text-sm text-red-500">
                </span>


                <div id="roomLoading"
                     class="hidden mt-3
                            text-sm text-slate-500
                            flex items-center gap-2">

                    <i data-lucide="loader-2"
                       class="w-4 h-4 animate-spin"></i>

                    Loading available rooms...

                </div>

            </div>


        </div>


        <!-- RIGHT -->
        <div class="space-y-6">


            <!-- Booking Summary -->
            <div class="bg-slate-900 rounded-2xl
                        text-white p-6 shadow-xl">

                <div class="flex items-center gap-3 mb-6">

                    <div class="w-10 h-10 rounded-xl
                                bg-white/10
                                flex items-center justify-center">

                        <i data-lucide="receipt"
                           class="w-5 h-5"></i>

                    </div>

                    <div>
                        <h2 class="font-bold">
                            Booking Summary
                        </h2>

                        <p class="text-sm text-slate-400">
                            Reservation calculation
                        </p>
                    </div>

                </div>


                <!-- Nights -->
                <div class="flex justify-between
                            py-3 border-b border-white/10">

                    <span class="text-slate-400">
                        Nights
                    </span>

                    <span id="nightsDisplay"
                          class="font-semibold">
                        1
                    </span>

                </div>


                <!-- Price -->
                <div class="flex justify-between
                            py-3 border-b border-white/10">

                    <span class="text-slate-400">
                        Price / Night
                    </span>

                    <span id="priceDisplay"
                          class="font-semibold">
                        0.00
                    </span>

                </div>


                <!-- Total -->
                <div class="pt-6">

                    <p class="text-sm text-slate-400">
                        Estimated Total
                    </p>

                    <div class="flex items-end
                                justify-between mt-2">

                        <span class="text-3xl font-bold"
                              id="totalDisplay">

                            0.00

                        </span>

                        <span class="text-sm
                                     text-slate-400 mb-1">

                            MMK

                        </span>

                    </div>

                </div>

            </div>


            <!-- Hidden calculation fields -->
            <input asp-for="PricePerNight"
                   type="hidden"
                   id="pricePerNight" />

            <input asp-for="NumberOfNights"
                   type="hidden"
                   id="numberOfNights" />

            <input asp-for="Amount"
                   type="hidden"
                   id="amount" />


            <!-- Actions -->
            <div class="bg-white rounded-2xl
                        border border-slate-200
                        shadow-sm p-5">

                <button type="submit"
                        class="w-full py-3.5
                               bg-slate-900
                               hover:bg-slate-800
                               text-white
                               rounded-xl
                               font-bold
                               flex items-center
                               justify-center gap-2
                               transition
                               shadow-lg shadow-slate-200">

                    <i data-lucide="check-circle"
                       class="w-5 h-5"></i>

                    Create Booking

                </button>


                <a asp-action="Index"
                   class="w-full mt-3 py-3.5
                          border border-slate-200
                          hover:bg-slate-50
                          text-slate-700
                          rounded-xl
                          font-semibold
                          flex items-center
                          justify-center gap-2
                          transition">

                    <i data-lucide="arrow-left"
                       class="w-4 h-4"></i>

                    Cancel

                </a>

            </div>


            <!-- Information -->
            <div class="rounded-2xl
                        bg-blue-50
                        border border-blue-100
                        p-5">

                <div class="flex gap-3">

                    <i data-lucide="info"
                       class="w-5 h-5
                              text-blue-600
                              shrink-0"></i>

                    <div>

                        <h3 class="font-semibold
                                   text-blue-900">

                            Booking Information

                        </h3>

                        <p class="text-sm
                                  text-blue-700
                                  mt-1 leading-6">

                            The selected room will be reserved
                            automatically after the booking is created.

                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</form>


</div>

@section Scripts {

<partial name="_ValidationScriptsPartial" />

<script>

    lucide.createIcons();


    function calculateBooking()
    {
        const checkIn =
            new Date($("#checkInDate").val());

        const checkOut =
            new Date($("#checkOutDate").val());

        if (
            isNaN(checkIn.getTime()) ||
            isNaN(checkOut.getTime())
        )
        {
            return;
        }

        const difference =
            checkOut.getTime() -
            checkIn.getTime();

        const nights =
            Math.ceil(
                difference /
                (1000 * 60 * 60 * 24)
            );

        if (nights > 0)
        {
            $("#nightsDisplay").text(nights);
            $("#numberOfNights").val(nights);

            calculateTotal();
        }
        else
        {
            $("#nightsDisplay").text("0");
            $("#numberOfNights").val("0");

            $("#totalDisplay").text("0.00");
            $("#amount").val("0");
        }
    }


    function calculateTotal()
    {
        const price =
            parseFloat(
                $("#pricePerNight").val()
            ) || 0;

        const nights =
            parseInt(
                $("#numberOfNights").val()
            ) || 0;

        const total =
            price * nights;

        $("#priceDisplay")
            .text(price.toLocaleString(
                undefined,
                {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }
            ));

        $("#totalDisplay")
            .text(total.toLocaleString(
                undefined,
                {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                }
            ));

        $("#amount").val(total);
    }


    function loadRooms()
    {
        const checkIn =
            $("#checkInDate").val();

        const checkOut =
            $("#checkOutDate").val();

        if (!checkIn || !checkOut)
            return;

        $("#roomLoading")
            .removeClass("hidden")
            .addClass("flex");

        $.get(
            "/Booking/GetAvailableRooms",
            {
                checkIn: checkIn,
                checkOut: checkOut
            },
            function (data)
            {
                const roomSelect =
                    $("#roomId");

                roomSelect.empty();

                roomSelect.append(
                    '<option value="">Select available room</option>'
                );

                data.forEach(function (room)
                {
                    roomSelect.append(
                        `<option value="${room.id}">
                            Room ${room.roomNumber}
                            - Floor ${room.floor}
                        </option>`
                    );
                });

                $("#roomLoading")
                    .addClass("hidden")
                    .removeClass("flex");

                lucide.createIcons();
            }
        );
    }


    function loadRoomPrice()
    {
        const roomId =
            $("#roomId").val();

        if (!roomId)
        {
            $("#pricePerNight").val("0");
            $("#priceDisplay").text("0.00");
            calculateTotal();
            return;
        }

        $.get(
            "/Booking/GetRoomPrice",
            {
                roomId: roomId
            },
            function (data)
            {
                if (data.success)
                {
                    $("#pricePerNight")
                        .val(data.price);

                    $("#priceDisplay")
                        .text(
                            Number(data.price)
                            .toLocaleString(
                                undefined,
                                {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }
                            )
                        );

                    calculateTotal();
                }
            }
        );
    }


    $("#checkInDate, #checkOutDate")
        .on("change", function ()
        {
            calculateBooking();
            loadRooms();
        });


    $("#roomId")
        .on("change", function ()
        {
            loadRoomPrice();
        });


    $(document).ready(function ()
    {
        calculateBooking();
    });

</script>

}
