@model HotelBookingMvc.Web.ViewModels.BookingCreateViewModel

@{
    ViewData["Title"] = "New Booking";
}

<div class="w-full">

    ```
    <!-- Header -->
    <div class="flex flex-col lg:flex-row
        lg:items-center
        lg:justify-between
        gap-4 mb-7">

        <div>

            <div class="flex items-center gap-2
                text-sm text-slate-400 mb-2">

                <a asp-action="Index"
                   class="hover:text-slate-700">
                    Bookings
                </a>

                <i data-lucide="chevron-right"
                   class="w-4 h-4"></i>

                <span>New Booking</span>

            </div>

            <h1 class="text-3xl font-bold text-slate-900">
                Create New Booking
            </h1>

            <p class="text-slate-500 mt-1">
                Create a reservation for your hotel guest.
            </p>

        </div>


        <a asp-action="Index"
           class="inline-flex items-center gap-2
            px-4 py-2.5
            bg-white
            border border-slate-200
            rounded-xl
            text-slate-700
            font-semibold
            hover:bg-slate-50
            transition">

            <i data-lucide="arrow-left"
               class="w-4 h-4"></i>

            Back to Bookings

        </a>

    </div>


