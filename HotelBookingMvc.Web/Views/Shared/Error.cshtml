@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="max-w-2xl mx-auto p-6 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl shadow-sm">
    <div class="flex items-center gap-3 text-red-600 dark:text-red-400 mb-4">
        <i data-lucide="alert-triangle" class="w-8 h-8"></i>
        <h1 class="text-2xl font-bold">An error occurred</h1>
    </div>
    <h2 class="text-lg font-medium text-slate-700 dark:text-slate-300 mb-4">An error occurred while processing your request.</h2>

    @if (Model.ShowRequestId)
    {
        <div class="p-4 mb-5 rounded-xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-sm">
            <span class="font-semibold text-slate-700 dark:text-slate-300">Request ID:</span>
            <code class="text-red-600 dark:text-red-400 font-mono">@Model.RequestId</code>
        </div>
    }

    <div class="text-xs text-slate-500 dark:text-slate-400 space-y-2">
        <h3 class="font-semibold text-slate-700 dark:text-slate-200">Development Information</h3>
        <p>
            Swapping to <strong>Development</strong> environment will display more detailed information about the error that occurred.
        </p>
    </div>
</div>
