@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KS7 Hotel</title>

    <!-- Apply theme before rendering to prevent a light/dark flash -->
    <script>
            (function () {
                try {
                    const savedTheme = localStorage.getItem("theme");
                    const prefersDark = window.matchMedia &&
                        window.matchMedia("(prefers-color-scheme: dark)").matches;

                    const useDark = savedTheme
                        ? savedTheme === "dark"
                        : prefersDark;

                    document.documentElement.classList.toggle("dark", useDark);
                } catch (error) {
                    document.documentElement.classList.remove("dark");
                }
            })();

            // Configure Tailwind CDN before loading the script to ensure class-based dark mode
            window.tailwind = {
                darkMode: "class"
            };
    </script>

    <!-- Existing local dependencies -->
    <script src="~/lib/tailwind/tailwind.js" asp-append-version="true"></script>
    <script>
            if (typeof tailwind !== "undefined" && tailwind.config) {
                tailwind.config.darkMode = "class";
            }
    </script>

    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
    <script src="~/lib/lucide/lucide.min.js" asp-append-version="true"></script>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
            :root {
                color-scheme: light;
                --app-bg: #f5f7fc;
                --surface: #ffffff;
                --surface-muted: #f8fafc;
                --text-primary: #172033;
                --text-secondary: #64748b;
                --border-color: #e7ebf2;
                --input-bg: #ffffff;
                --hover-bg: #f1f5f9;
                --sidebar-bg: #020617;
                --sidebar-text: #cbd5e1;
                --accent: #3b82f6;
                --shadow-color: rgba(15, 23, 42, 0.07);
            }

            html.dark {
                color-scheme: dark;
                --app-bg: #0b1120;
                --surface: #111c30;
                --surface-muted: #162238;
                --text-primary: #f1f5f9;
                --text-secondary: #a0aec0;
                --border-color: #2a3850;
                --input-bg: #0b1425;
                --hover-bg: #1e2b40;
                --sidebar-bg: #020617;
                --sidebar-text: #cbd5e1;
                --accent: #60a5fa;
                --shadow-color: rgba(0, 0, 0, 0.22);
            }

            *,
            *::before,
            *::after {
                box-sizing: border-box;
            }

            html {
                min-height: 100%;
                scroll-behavior: smooth;
                background: var(--app-bg);
            }

            body {
                margin: 0;
                min-height: 100vh;
                background: var(--app-bg);
                color: var(--text-primary);
                font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
                font-size: 14px;
                line-height: 1.5;
                transition: background-color .25s ease, color .25s ease;
            }

            button,
            input,
            select,
            textarea {
                font: inherit;
            }

            button,
            a,
            input,
            select,
            textarea {
                -webkit-tap-highlight-color: transparent;
            }

            a {
                text-decoration: none;
            }

            /* ================= SIDEBAR ================= */

            .sidebar {
                position: fixed;
                inset: 0 auto 0 0;
                z-index: 100;
                display: flex;
                flex-direction: column;
                width: 260px;
                overflow: hidden;
                color: var(--sidebar-text);
                background: var(--sidebar-bg);
                border-right: 1px solid rgba(148, 163, 184, .12);
            }

            .sidebar-brand {
                flex-shrink: 0;
                padding: 22px 18px;
                border-bottom: 1px solid rgba(148, 163, 184, .15);
            }

            .brand-row {
                display: flex;
                align-items: center;
                gap: 12px;
                min-width: 0;
            }

            .brand-logo {
                position: relative;
                display: flex;
                flex: 0 0 48px;
                align-items: center;
                justify-content: center;
                width: 48px;
                height: 48px;
                overflow: hidden;
                border: 2px solid rgba(59, 130, 246, .65);
                border-radius: 50%;
                background: #0b1730;
                box-shadow: 0 0 18px rgba(37, 99, 235, .2);
            }

                .brand-logo img {
                    position: absolute;
                    inset: 0;
                    display: block;
                    width: 100%;
                    height: 100%;
                    max-width: none;
                    object-fit: cover;
                    object-position: center;
                    border-radius: inherit;
                }

            .brand-fallback {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 100%;
                height: 100%;
                color: white;
                font-size: 13px;
                font-weight: 900;
                letter-spacing: -1px;
            }

            .brand-copy {
                min-width: 0;
            }

            .brand-title {
                margin: 0;
                color: #fff;
                font-size: 17px;
                font-weight: 850;
                letter-spacing: .06em;
                line-height: 1.3;
                white-space: nowrap;
            }

            .brand-subtitle {
                margin: 4px 0 0;
                color: #94a3b8;
                font-size: 11px;
                white-space: nowrap;
            }

            .sidebar-scroll {
                flex: 1;
                min-height: 0;
                padding: 18px 12px;
                overflow-x: hidden;
                overflow-y: auto;
                overscroll-behavior: contain;
            }

            .nav-section-title {
                margin: 18px 10px 8px;
                color: #8492a8;
                font-size: 10px;
                font-weight: 750;
                letter-spacing: .14em;
                text-transform: uppercase;
            }

                .nav-section-title:first-child {
                    margin-top: 0;
                }

            .sidebar-nav {
                display: grid;
                gap: 4px;
            }

            .nav-item {
                position: relative;
                display: flex;
                align-items: center;
                gap: 12px;
                min-height: 44px;
                padding: 10px 12px;
                border: 1px solid transparent;
                border-radius: 10px;
                color: #aab7ca;
                font-size: 13px;
                font-weight: 550;
                transition: background-color .18s ease, color .18s ease, border-color .18s ease;
            }

                .nav-item > i,
                .nav-item > svg {
                    flex: 0 0 19px;
                    width: 19px;
                    height: 19px;
                }

                .nav-item:hover {
                    color: #fff;
                    background: rgba(148, 163, 184, .12);
                }

                .nav-item.active {
                    color: #fff;
                    background: linear-gradient(110deg, #1d4ed8, #4338ca);
                    border-color: rgba(147, 197, 253, .22);
                    box-shadow: 0 5px 16px rgba(37, 99, 235, .18);
                }

                    .nav-item.active::before {
                        position: absolute;
                        top: 10px;
                        bottom: 10px;
                        left: -1px;
                        width: 3px;
                        border-radius: 0 4px 4px 0;
                        background: #93c5fd;
                        content: "";
                    }

            .sidebar-footer {
                flex-shrink: 0;
                padding: 12px;
                border-top: 1px solid rgba(148, 163, 184, .15);
            }

            .signout-link {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 11px 12px;
                border-radius: 10px;
                color: #cbd5e1;
                transition: background-color .18s ease, color .18s ease;
            }

                .signout-link:hover {
                    color: #fff;
                    background: rgba(244, 63, 94, .13);
                }

            /* ================= MAIN LAYOUT ================= */

            .main-content {
                display: flex;
                flex-direction: column;
                min-width: 0;
                min-height: 100vh;
                margin-left: 260px;
                background: var(--app-bg);
                transition: background-color .25s ease;
            }

            .topbar {
                position: sticky;
                top: 0;
                z-index: 40;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 16px;
                min-height: 76px;
                padding: 12px 28px;
                background: var(--surface);
                border-bottom: 1px solid var(--border-color);
                transition: background-color .25s ease, border-color .25s ease;
            }

            .topbar-heading {
                min-width: 0;
            }

            .topbar-brand {
                color: var(--text-secondary);
                font-size: 11px;
                letter-spacing: .04em;
            }

            .topbar-title {
                margin: 3px 0 0;
                color: var(--text-primary);
                font-size: 18px;
                font-weight: 750;
                line-height: 1.4;
            }

            .topbar-actions {
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .icon-button {
                position: relative;
                display: inline-flex;
                flex: 0 0 42px;
                align-items: center;
                justify-content: center;
                width: 42px;
                height: 42px;
                padding: 0;
                color: var(--text-secondary);
                background: var(--surface-muted);
                border: 1px solid var(--border-color);
                border-radius: 12px;
                cursor: pointer;
                transition: background-color .2s ease, color .2s ease, border-color .2s ease, transform .2s ease;
            }

                .icon-button:hover {
                    color: var(--accent);
                    background: var(--hover-bg);
                    transform: translateY(-1px);
                }

                .icon-button svg {
                    width: 19px;
                    height: 19px;
                }

            .theme-icon-sun {
                display: none;
            }

            html.dark .theme-icon-sun {
                display: block;
                color: #fbbf24;
            }

            html.dark .theme-icon-moon {
                display: none;
            }

            .topbar-date {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 10px 12px;
                color: var(--text-secondary);
                background: var(--surface-muted);
                border: 1px solid var(--border-color);
                border-radius: 10px;
                white-space: nowrap;
            }

            .page-content {
                flex: 1;
                min-width: 0;
                padding: 26px 28px;
                animation: pageEnter .24s ease both;
            }

            /* ================= THEME CONSISTENCY ================= */

            body,
            .main-content,
            .topbar,
            .page-content,
            .premium-card,
            .topbar-date,
            .icon-button,
            .toast-message {
                transition: background-color .22s ease, color .22s ease, border-color .22s ease, box-shadow .22s ease;
            }

            html.dark body,
            html.dark .main-content,
            html.dark .page-content {
                color: var(--text-primary);
                background: var(--app-bg);
            }

            html.dark .topbar {
                color: var(--text-primary);
                background-color: var(--surface);
                border-color: var(--border-color);
            }

            html.dark .bg-white:not([class*="dark:bg-"]):not([class*="bg-blue-"]):not([class*="bg-indigo-"]):not([class*="bg-emerald-"]):not([class*="bg-red-"]):not([class*="bg-amber-"]) {
                background-color: var(--surface);
                border-color: var(--border-color);
            }

            html.dark .bg-gray-50:not([class*="dark:bg-"]),
            html.dark .bg-gray-100:not([class*="dark:bg-"]),
            html.dark .bg-slate-50:not([class*="dark:bg-"]),
            html.dark .bg-slate-100:not([class*="dark:bg-"]) {
                background-color: var(--surface-muted);
                border-color: var(--border-color);
            }

            html.dark .text-gray-900:not([class*="dark:text-"]):not([class*="text-white"]),
            html.dark .text-gray-800:not([class*="dark:text-"]):not([class*="text-white"]),
            html.dark .text-gray-700:not([class*="dark:text-"]):not([class*="text-white"]),
            html.dark .text-slate-900:not([class*="dark:text-"]):not([class*="text-white"]),
            html.dark .text-slate-800:not([class*="dark:text-"]):not([class*="text-white"]),
            html.dark .text-slate-700:not([class*="dark:text-"]):not([class*="text-white"]) {
                color: var(--text-primary);
            }

            html.dark .text-gray-600:not([class*="dark:text-"]):not([class*="text-white"]),
            html.dark .text-gray-500:not([class*="dark:text-"]):not([class*="text-white"]),
            html.dark .text-gray-400:not([class*="dark:text-"]):not([class*="text-white"]),
            html.dark .text-slate-600:not([class*="dark:text-"]):not([class*="text-white"]),
            html.dark .text-slate-500:not([class*="dark:text-"]):not([class*="text-white"]),
            html.dark .text-slate-400:not([class*="dark:text-"]):not([class*="text-white"]) {
                color: var(--text-secondary);
            }

            html.dark input:not([type="checkbox"]):not([type="radio"]):not([type="hidden"]):not([class*="dark:bg-"]),
            html.dark select:not([class*="dark:bg-"]),
            html.dark textarea:not([class*="dark:bg-"]) {
                color: var(--text-primary);
                background-color: var(--input-bg);
                border-color: var(--border-color);
            }

            html.dark input::placeholder,
            html.dark textarea::placeholder {
                color: #64748b;
            }

            html.dark option {
                color: var(--text-primary);
                background: var(--surface);
            }

            html.dark table {
                color: var(--text-primary);
                border-color: var(--border-color);
            }

            html.dark th {
                color: #cbd5e1;
                background-color: var(--surface-muted);
            }

            html.dark td,
            html.dark th {
                border-color: var(--border-color);
            }

            html.dark tr:hover td {
                background-color: rgba(148, 163, 184, .06);
            }

            html.dark .shadow,
            html.dark .shadow-sm,
            html.dark .shadow-md,
            html.dark .shadow-lg,
            html.dark .shadow-xl {
                --tw-shadow-color: rgba(0, 0, 0, .2);
            }

            /* Keep semantic success/error messages readable in both themes */
            .toast-message {
                margin: 16px 28px 0;
                padding: 13px 16px;
                border: 1px solid;
                border-radius: 12px;
            }

            .toast-success {
                color: #166534;
                background: #f0fdf4;
                border-color: #bbf7d0;
            }

            .toast-error {
                color: #991b1b;
                background: #fef2f2;
                border-color: #fecaca;
            }

            html.dark .toast-success {
                color: #bbf7d0;
                background: #10291f;
                border-color: #245b40;
            }

            html.dark .toast-error {
                color: #fecaca;
                background: #351b25;
                border-color: #713044;
            }

            .toast-close {
                margin-left: 12px;
                color: inherit;
                font-size: 21px;
                line-height: 1;
                cursor: pointer;
            }

            /* ================= ANIMATION ================= */

            @@keyframes pageEnter {
                from {
                    opacity: 0;
                    transform: translateY(5px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                *,
                *::before,
                *::after {
                    scroll-behavior: auto !important;
                    animation-duration: .01ms !important;
                    animation-iteration-count: 1 !important;
                    transition-duration: .01ms !important;
                }
            }

            /* ================= RESPONSIVE ================= */

            .sidebar-text {
                min-width: 0;
            }

            @@media (max-width: 900px) {
                .sidebar {
                    width: 76px;
                }

                .sidebar-brand {
                    display: flex;
                    justify-content: center;
                    padding: 16px 8px;
                }

                .brand-row {
                    justify-content: center;
                }

                .brand-logo {
                    flex-basis: 44px;
                    width: 44px;
                    height: 44px;
                }

                .brand-copy,
                .sidebar-text,
                .nav-section-title {
                    display: none;
                }

                .sidebar-scroll {
                    padding: 16px 8px;
                }

                .nav-item {
                    justify-content: center;
                    gap: 0;
                    padding: 12px 6px;
                }

                .sidebar-footer {
                    padding: 8px;
                }

                .signout-link {
                    justify-content: center;
                    padding: 12px 6px;
                }

                .main-content {
                    margin-left: 76px;
                }

                .topbar {
                    padding-right: 18px;
                    padding-left: 18px;
                }

                .page-content {
                    padding: 22px 18px;
                }

                .toast-message {
                    margin-right: 18px;
                    margin-left: 18px;
                }
            }

            @@media (max-width: 560px) {
                .topbar {
                    min-height: 66px;
                    gap: 8px;
                    padding: 10px 12px;
                }

                .topbar-title {
                    font-size: 15px;
                }

                .topbar-actions {
                    gap: 6px;
                }

                .icon-button {
                    flex-basis: 38px;
                    width: 38px;
                    height: 38px;
                }

                .topbar-date {
                    display: none;
                }

                .page-content {
                    padding: 16px 12px;
                }

                .toast-message {
                    margin-right: 12px;
                    margin-left: 12px;
                }
            }

            /* Scrollbar */
            ::-webkit-scrollbar {
                width: 7px;
                height: 7px;
            }

            ::-webkit-scrollbar-track {
                background: transparent;
            }

            ::-webkit-scrollbar-thumb {
                background: #94a3b8;
                border: 2px solid transparent;
                border-radius: 10px;
                background-clip: padding-box;
            }
    </style>
</head>

<body>
    <!-- ================= SIDEBAR ================= -->

    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-row">
                <div class="brand-logo">
                    <span class="brand-fallback">KS7</span>
                    <img src="~/css/logo.png"
                         asp-append-version="true"
                         alt="KS7 Hotel Logo"
                         onerror="this.style.display='none'" />
                </div>

                <div class="brand-copy">
                    <h1 class="brand-title">KS7 HOTEL</h1>
                    <p class="brand-subtitle">Hotel Booking System</p>
                </div>
            </div>
        </div>

        <div class="sidebar-scroll">
            <div class="nav-section-title">Main</div>
            <nav class="sidebar-nav">
                <a asp-controller="Dashboard" asp-action="Index"
                   class="nav-item @(string.Equals(currentController, "Dashboard", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   title="Dashboard">
                    <i data-lucide="layout-dashboard"></i>
                    <span class="sidebar-text">Dashboard</span>
                </a>

                <a asp-controller="Booking" asp-action="Index"
                   class="nav-item @(string.Equals(currentController, "Booking", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   title="Bookings">
                    <i data-lucide="calendar-check"></i>
                    <span class="sidebar-text">Bookings</span>
                </a>

                <a asp-controller="CheckIn" asp-action="Index"
                   class="nav-item @(string.Equals(currentController, "CheckIn", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   title="Check-in">
                    <i data-lucide="log-in"></i>
                    <span class="sidebar-text">Check-in</span>
                </a>

                <a asp-controller="CheckOut" asp-action="Index"
                   class="nav-item @(string.Equals(currentController, "CheckOut", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   title="Check-out">
                    <i data-lucide="log-out"></i>
                    <span class="sidebar-text">Check-out</span>
                </a>
            </nav>

            <div class="nav-section-title">Management</div>
            <nav class="sidebar-nav">
                <a asp-controller="Customer" asp-action="Index"
                   class="nav-item @(string.Equals(currentController, "Customer", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   title="Customers">
                    <i data-lucide="users"></i>
                    <span class="sidebar-text">Customers</span>
                </a>

                <a asp-controller="Room" asp-action="Index"
                   class="nav-item @(string.Equals(currentController, "Room", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   title="Rooms">
                    <i data-lucide="bed-double"></i>
                    <span class="sidebar-text">Rooms</span>
                </a>

                <a asp-controller="RoomType" asp-action="Index"
                   class="nav-item @(string.Equals(currentController, "RoomType", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   title="Room Types">
                    <i data-lucide="layers-3"></i>
                    <span class="sidebar-text">Room Types</span>
                </a>

                <a asp-controller="RoomStatus" asp-action="Index"
                   class="nav-item @(string.Equals(currentController, "RoomStatus", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   title="Room Status">
                    <i data-lucide="shield-check"></i>
                    <span class="sidebar-text">Room Status</span>
                </a>

                <a asp-controller="RoomPrice" asp-action="Index"
                   class="nav-item @(string.Equals(currentController, "RoomPrice", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   title="Room Pricing">
                    <i data-lucide="tag"></i>
                    <span class="sidebar-text">Room Pricing</span>
                </a>

                <a asp-controller="Floor" asp-action="Index"
                   class="nav-item @(string.Equals(currentController, "Floor", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   title="Floors">
                    <i data-lucide="building-2"></i>
                    <span class="sidebar-text">Floors</span>
                </a>

                <a asp-controller="Service" asp-action="Index"
                   class="nav-item @(string.Equals(currentController, "Service", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   title="Services">
                    <i data-lucide="concierge-bell"></i>
                    <span class="sidebar-text">Services</span>
                </a>
                <a asp-controller="ExtraBedPrice"
                   asp-action="Index"
                   class="flex items-center gap-3 rounded-xl px-4 py-3 text-gray-300 transition hover:bg-cyan-500/15 hover:text-white">
                    <span>🛏️</span>
                    <span>Extra Bed Price</span>
                </a>
            </nav>

            <div class="nav-section-title">Finance</div>
            <nav class="sidebar-nav">
                <a asp-controller="Payment" asp-action="Index"
                   class="nav-item @(string.Equals(currentController, "Payment", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   title="Payments">
                    <i data-lucide="credit-card"></i>
                    <span class="sidebar-text">Payments</span>
                </a>

                <a asp-controller="Report" asp-action="Index"
                   class="nav-item @(string.Equals(currentController, "Report", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   title="Reports">
                    <i data-lucide="chart-column"></i>
                    <span class="sidebar-text">Reports</span>
                </a>

                <a asp-controller="Notification" asp-action="Index"
                   class="nav-item @(string.Equals(currentController, "Notification", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                   title="Notifications">
                    <i data-lucide="bell"></i>
                    <span class="sidebar-text">Notifications</span>
                    <span id="notificationBadge"
                          class="hidden ml-auto bg-red-500 text-white text-xs px-2 py-0.5 rounded-full">0</span>
                </a>
            </nav>
        </div>

        <div class="sidebar-footer">
            <a asp-controller="Login" asp-action="Logout"
               class="signout-link"
               title="Sign Out">
                <i data-lucide="log-out" style="width:19px;height:19px;color:#fb7185;flex-shrink:0"></i>
                <span class="sidebar-text">Sign Out</span>
            </a>
        </div>
    </aside>

    <!-- ================= MAIN CONTENT ================= -->

    <main class="main-content">
        <header class="topbar">
            <div class="topbar-heading">
                <div class="topbar-brand">KS7 Hotel</div>
                <h2 class="topbar-title">
                    @(ViewData["Title"] ?? "Dashboard")
                </h2>
            </div>

            <div class="topbar-actions">
                <button id="themeToggleBtn"
                        type="button"
                        class="icon-button"
                        title="Switch to dark theme"
                        aria-label="Toggle light and dark theme">
                    <i class="theme-icon-moon" data-lucide="moon"></i>
                    <i class="theme-icon-sun" data-lucide="sun"></i>
                </button>

                <a asp-controller="Notification"
                   asp-action="Index"
                   class="icon-button"
                   title="Notifications"
                   aria-label="Notifications">
                    <i data-lucide="bell"></i>
                    <span id="topNotificationBadge"
                          class="hidden absolute -top-1 -right-1 min-w-[20px] h-5 px-1 bg-red-500 text-white text-xs rounded-full items-center justify-center">0</span>
                </a>

                <div class="topbar-date">
                    <i data-lucide="calendar-days" style="width:16px;height:16px"></i>
                    <span>@DateTime.Now.ToString("dd MMM yyyy")</span>
                </div>
            </div>
        </header>

        @if (TempData["Success"] != null)
        {
            <div class="toast-message toast-success" role="status">
                <div class="flex items-center justify-between gap-3">
                    <span>@TempData["Success"]</span>
                    <button type="button" class="toast-close"
                            aria-label="Close message"
                            onclick="this.closest('.toast-message').remove()">
                        &times;
                    </button>
                </div>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="toast-message toast-error" role="alert">
                <div class="flex items-center justify-between gap-3">
                    <span>@TempData["Error"]</span>
                    <button type="button" class="toast-close"
                            aria-label="Close message"
                            onclick="this.closest('.toast-message').remove()">
                        &times;
                    </button>
                </div>
            </div>
        }

        <section class="page-content">
            @RenderBody()
        </section>
    </main>

    <!-- ================= JAVASCRIPT ================= -->

    <script>
            // Initialize icons after the page has loaded.
            function refreshLucideIcons() {
                if (window.lucide && typeof window.lucide.createIcons === "function") {
                    window.lucide.createIcons();
                }
            }

            document.addEventListener("DOMContentLoaded", function () {
                refreshLucideIcons();

                // Theme toggle
                const themeToggleBtn = document.getElementById("themeToggleBtn");

                function updateThemeButton() {
                    const isDark = document.documentElement.classList.contains("dark");

                    if (themeToggleBtn) {
                        themeToggleBtn.title = isDark
                            ? "Switch to light theme"
                            : "Switch to dark theme";

                        themeToggleBtn.setAttribute(
                            "aria-label",
                            themeToggleBtn.title
                        );
                    }
                }

                if (themeToggleBtn) {
                    themeToggleBtn.addEventListener("click", function () {
                        const isDark = document.documentElement.classList.toggle("dark");

                        try {
                            localStorage.setItem("theme", isDark ? "dark" : "light");
                        } catch (error) {
                            console.warn("Could not save theme preference.", error);
                        }

                        updateThemeButton();
                        refreshLucideIcons();
                        window.dispatchEvent(new CustomEvent("themechange", { detail: { isDark } }));
                    });
                }

                updateThemeButton();

                // Notification count
                window.loadNotificationCount = function () {
                    if (!window.jQuery) return;

                    $.ajax({
                        url: "/Notification/Count",
                        type: "GET",
                        cache: false,
                        success: function (count) {
                            const number = Number(count) || 0;
                            const sidebarBadge = $("#notificationBadge");
                            const topBadge = $("#topNotificationBadge");

                            sidebarBadge.text(number);
                            topBadge.text(number);

                            if (number > 0) {
                                sidebarBadge.removeClass("hidden");
                                topBadge.removeClass("hidden").addClass("flex");
                            } else {
                                sidebarBadge.addClass("hidden");
                                topBadge.addClass("hidden").removeClass("flex");
                            }
                        },
                        error: function (xhr) {
                            console.warn(
                                "Could not load notification count:",
                                xhr.status
                            );
                        }
                    });
                };

                // SignalR live notification updates
                if (typeof signalR !== "undefined") {
                    const connection = new signalR.HubConnectionBuilder()
                        .withUrl("/hotelHub")
                        .withAutomaticReconnect()
                        .configureLogging(signalR.LogLevel.Warning)
                        .build();

                    connection.on("HotelUpdated", function () {
                        window.loadNotificationCount();
                    });

                    connection.onreconnected(function () {
                        window.loadNotificationCount();
                    });

                    async function startHotelHub() {
                        try {
                            await connection.start();
                            window.loadNotificationCount();
                        } catch (error) {
                            console.warn("SignalR connection failed; retrying.", error);
                            window.setTimeout(startHotelHub, 5000);
                        }
                    }

                    startHotelHub();
                } else {
                    window.loadNotificationCount();
                }
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
