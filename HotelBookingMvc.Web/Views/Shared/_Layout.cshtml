@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - KS7 Hotel</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script>
        tailwind.config = {
            darkMode: 'class'
        };
        if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>


    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script src="https://unpkg.com/lucide@latest"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        * {
            font-family: 'Inter', sans-serif;
        }

        h1, h2, h3, .heading-font {
            font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
        }
    </style>
</head>


<body>

    <!-- Ambient Floating Glass Orbs for Dynamic Refraction -->
    <div class="glass-bg-mesh fixed inset-0 pointer-events-none -z-10 overflow-hidden" aria-hidden="true">
        <div class="glass-orb glass-orb-1"></div>
        <div class="glass-orb glass-orb-2"></div>
        <div class="glass-orb glass-orb-3"></div>
        <div class="glass-orb glass-orb-4"></div>
    </div>

    <!-- ================================================= -->
    <!-- SIDEBAR -->
    <!-- ================================================= -->

    <aside class="glass-sidebar sidebar fixed left-0 top-0 bottom-0 z-50 flex flex-col">

        <!-- LOGO -->
        <div class="px-5 py-6 border-b border-slate-200/60 dark:border-white/10">
            <div class="flex items-center gap-3">
                <!-- CIRCULAR KS7 LOGO -->
                <div class="relative flex-shrink-0">
                    <div class="w-12 h-12 rounded-2xl
                        overflow-hidden
                        ring-2 ring-blue-500/40
                        shadow-lg shadow-blue-500/20 backdrop-blur-md">
                        <img src="~/css/logo.png"
                             asp-append-version="true"
                             alt="KS7 Logo"
                             class="w-full h-full object-cover" />
                    </div>
                    <!-- Small Glow -->
                    <div class="absolute -inset-1 rounded-2xl
                        bg-gradient-to-tr from-blue-500 to-indigo-500 opacity-40
                        blur-md -z-10 animate-pulse">
                    </div>
                </div>

                <!-- HOTEL NAME -->
                <div>
                    <h1 class="text-slate-900 dark:text-white text-base font-extrabold
                        tracking-wider flex items-center gap-1.5">
                        <span class="bg-gradient-to-r from-blue-600 via-indigo-600 to-violet-600 dark:from-blue-400 dark:via-indigo-300 dark:to-purple-400 bg-clip-text text-transparent">
                            KS7 HOTEL
                        </span>
                    </h1>
                    <p class="text-[11px] font-medium text-slate-500 dark:text-slate-400 tracking-wider uppercase mt-0.5">
                        Booking System
                    </p>
                </div>
            </div>
        </div>


        <!-- NAVIGATION -->

        <div class="p-4 overflow-y-auto
            h-[calc(100vh-80px)]">


            <!-- MAIN -->

            <div class="text-[11px] uppercase
                tracking-widest
                text-slate-600
                font-semibold
                px-3 mb-3 sidebar-text">

                Main

            </div>


            <nav class="space-y-2">


                <!-- DASHBOARD -->

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="nav-item flex items-center gap-3
                    px-4 py-3 rounded-xl
                    @(currentController == "Dashboard" ? "active" : "")">

                    <i data-lucide="layout-dashboard"
                       class="w-5 h-5">
                    </i>

                    <span class="sidebar-text">

                        Dashboard

                    </span>

                </a>


                <!-- BOOKINGS -->

                <a asp-controller="Booking"
                   asp-action="Index"
                   class="nav-item flex items-center gap-3
                    px-4 py-3 rounded-xl
                    @(currentController == "Booking" ? "active" : "")">

                    <i data-lucide="calendar-check"
                       class="w-5 h-5">
                    </i>

                    <span class="sidebar-text">

                        Bookings

                    </span>

                </a>


                <!-- CHECK IN -->

                <a asp-controller="CheckIn"
                   asp-action="Index"
                   class="nav-item flex items-center gap-3
                    px-4 py-3 rounded-xl
                    @(currentController == "CheckIn" ? "active" : "")">

                    <i data-lucide="log-in"
                       class="w-5 h-5">
                    </i>

                    <span class="sidebar-text">

                        Check-in

                    </span>

                </a>


                <!-- CHECK OUT -->

                <a asp-controller="CheckOut"
                   asp-action="Index"
                   class="nav-item flex items-center gap-3
                    px-4 py-3 rounded-xl
                    @(currentController == "CheckOut" ? "active" : "")">

                    <i data-lucide="log-out"
                       class="w-5 h-5">
                    </i>

                    <span class="sidebar-text">

                        Check-out

                    </span>

                </a>

            </nav>


            <!-- MANAGEMENT -->

            <div class="text-[11px] uppercase
                tracking-widest
                text-slate-600
                font-semibold
                px-3 mt-8 mb-3 sidebar-text">

                Management

            </div>


            <nav class="space-y-2">


                <!-- CUSTOMER -->

                <a asp-controller="Customer"
                   asp-action="Index"
                   class="nav-item flex items-center gap-3
                    px-4 py-3 rounded-xl
                    @(currentController == "Customer" ? "active" : "")">

                    <i data-lucide="users"
                       class="w-5 h-5">
                    </i>

                    <span class="sidebar-text">

                        Customers

                    </span>

                </a>


                <!-- ROOM -->

                <a asp-controller="Room"
                   asp-action="Index"
                   class="nav-item flex items-center gap-3
                    px-4 py-3 rounded-xl
                    @(currentController == "Room" ? "active" : "")">

                    <i data-lucide="bed-double"
                       class="w-5 h-5">
                    </i>

                    <span class="sidebar-text">

                        Rooms

                    </span>

                </a>


                <!-- ROOM TYPE -->

                <a asp-controller="RoomType"
                   asp-action="Index"
                   class="nav-item flex items-center gap-3
                    px-4 py-3 rounded-xl
                    @(currentController == "RoomType" ? "active" : "")">

                    <i data-lucide="layers-3"
                       class="w-5 h-5">
                    </i>

                    <span class="sidebar-text">

                        Room Types

                    </span>

                </a>


                <!-- SERVICES -->

            @*     <a asp-controller="Service"
                   asp-action="Index"
                   class="nav-item flex items-center gap-3
                    px-4 py-3 rounded-xl
                    @(currentController == "Service" ? "active" : "")">

                    <i data-lucide="concierge-bell"
                       class="w-5 h-5">
                    </i>

                    <span class="sidebar-text">

                        Services

                    </span>

                </a> *@

            </nav>


            <!-- FINANCE -->

            <div class="text-[11px] uppercase
                tracking-widest
                text-slate-600
                font-semibold
                px-3 mt-8 mb-3 sidebar-text">

                Finance

            </div>


            <nav class="space-y-2">


                <!-- PAYMENT -->

                <a asp-controller="Payment"
                   asp-action="Index"
                   class="nav-item flex items-center gap-3
                    px-4 py-3 rounded-xl
                    @(currentController == "Payment" ? "active" : "")">

                    <i data-lucide="credit-card"
                       class="w-5 h-5">
                    </i>

                    <span class="sidebar-text">

                        Payments

                    </span>

                </a>


                <!-- REPORT -->

                <a asp-controller="Report"
                   asp-action="Index"
                   class="nav-item flex items-center gap-3
                    px-4 py-3 rounded-xl
                    @(currentController == "Report" ? "active" : "")">

                    <i data-lucide="bar-chart-3"
                       class="w-5 h-5">
                    </i>

                    <span class="sidebar-text">

                        Reports

                    </span>

                </a>


                <!-- NOTIFICATION -->

                <a asp-controller="Notification"
                   asp-action="Index"
                   class="nav-item flex items-center gap-3
                    px-4 py-3 rounded-xl
                    @(currentController == "Notification" ? "active" : "")">

                    <i data-lucide="bell"
                       class="w-5 h-5">
                    </i>

                    <span class="sidebar-text">

                        Notifications

                    </span>

                    <span id="notificationBadge"
                          class="hidden ml-auto
                        bg-red-500 text-white
                        text-xs px-2 py-1
                        rounded-full">

                        0

                    </span>

                </a>

            </nav>

        </div>

    </aside>


    <!-- ================================================= -->
    <!-- MAIN CONTENT -->
    <!-- ================================================= -->

    <main class="main-content">


        <!-- TOP BAR -->

        <header class="glass-header h-20 flex items-center justify-between px-8 sticky top-0 z-40 transition-all duration-300">

            <div class="flex items-center gap-3">
                <div>
                    <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-400">
                        <span>KS7 Hotel</span>
                        <span class="inline-flex items-center gap-1 text-[10px] text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20 font-medium">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                            Online
                        </span>
                    </div>
                    <div class="text-xl font-extrabold text-slate-800 dark:text-white tracking-tight mt-0.5">
                        @ViewData["Title"]
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-3.5">

                <!-- THEME TOGGLE BUTTON -->
                <button id="themeToggleBtn"
                        type="button"
                        title="Toggle Light / Dark Theme"
                        class="glass-btn relative w-11 h-11
                         rounded-xl flex items-center justify-center
                         cursor-pointer transition-all duration-300 hover:scale-105 active:scale-95 shadow-sm">
                    <i id="themeSunIcon"
                       data-lucide="sun"
                       class="w-5 h-5 hidden dark:block text-amber-400">
                    </i>
                    <i id="themeMoonIcon"
                       data-lucide="moon"
                       class="w-5 h-5 block dark:hidden text-slate-600">
                    </i>
                </button>

                <!-- NOTIFICATION -->
                <a asp-controller="Notification"
                   asp-action="Index"
                   class="glass-btn relative w-11 h-11
                    rounded-xl flex items-center justify-center
                    transition-all duration-300 hover:scale-105 shadow-sm">
                    <i data-lucide="bell"
                       class="w-5 h-5 text-slate-600 dark:text-slate-300">
                    </i>
                    <span id="topNotificationBadge"
                          class="hidden absolute -top-1 -right-1
                        min-w-[20px] h-5
                        bg-rose-500 text-white
                        text-xs font-bold rounded-full
                        items-center justify-center px-1 border-2 border-white dark:border-slate-900 shadow-md">
                        0
                    </span>
                </a>

                <!-- DATE -->
                <div class="glass-date-pill hidden md:flex
                    items-center gap-2
                    px-4 py-2.5
                    rounded-xl text-slate-700 dark:text-slate-200">
                    <i data-lucide="calendar-days"
                       class="w-4 h-4 text-indigo-500">
                    </i>
                    <span class="text-xs font-semibold">
                        @DateTime.Now.ToString("dd MMM yyyy")
                    </span>
                </div>

            </div>

        </header>


        <!-- PAGE CONTENT -->

        <!-- GLOBAL TOAST NOTIFICATION OVERLAY -->
        <div id="globalToastContainer" class="fixed top-5 right-5 z-[9999] flex flex-col gap-3 max-w-md w-full pointer-events-none px-4 sm:px-0">
            @if (TempData["Success"] != null)
            {
                <div id="globalSuccessToast" 
                     class="pointer-events-auto glass-toast rounded-2xl p-4 shadow-2xl flex items-center gap-3.5 transform translate-y-0 opacity-100 transition-all duration-300 ease-out">
                    <div class="w-10 h-10 rounded-xl bg-emerald-500/10 flex items-center justify-center flex-shrink-0 text-emerald-500 border border-emerald-500/20">
                        <i data-lucide="check-circle-2" class="w-6 h-6"></i>
                    </div>

                    <div class="flex-1 min-w-0">
                        <h4 class="text-sm font-bold text-gray-900 dark:text-white">
                            Success
                        </h4>
                        <p class="text-xs text-gray-600 dark:text-gray-300 font-medium mt-0.5">
                            @TempData["Success"]
                        </p>
                    </div>

                    <button onclick="dismissGlobalToast('globalSuccessToast')" 
                            class="text-gray-400 hover:text-gray-600 dark:hover:text-white p-1 rounded-lg hover:bg-black/5 dark:hover:bg-white/10 transition">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div id="globalErrorToast" 
                     class="pointer-events-auto glass-toast rounded-2xl p-4 shadow-2xl flex items-center gap-3.5 transform translate-y-0 opacity-100 transition-all duration-300 ease-out">
                    <div class="w-10 h-10 rounded-xl bg-rose-500/10 flex items-center justify-center flex-shrink-0 text-rose-500 border border-rose-500/20">
                        <i data-lucide="alert-circle" class="w-6 h-6"></i>
                    </div>

                    <div class="flex-1 min-w-0">
                        <h4 class="text-sm font-bold text-gray-900 dark:text-white">
                            Error
                        </h4>
                        <p class="text-xs text-gray-600 dark:text-gray-300 font-medium mt-0.5">
                            @TempData["Error"]
                        </p>
                    </div>

                    <button onclick="dismissGlobalToast('globalErrorToast')" 
                            class="text-gray-400 hover:text-gray-600 dark:hover:text-white p-1 rounded-lg hover:bg-black/5 dark:hover:bg-white/10 transition">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                </div>
            }
        </div>

        <section class="p-8 page-animation">

            @RenderBody()

        </section>

    </main>


    <script>

            if (window.lucide) {
                lucide.createIcons();
            }

            document.addEventListener("DOMContentLoaded", function () {
                if (window.lucide) {
                    lucide.createIcons();
                }
            });

            // Theme Toggle Logic
            const themeToggleBtn = document.getElementById('themeToggleBtn');
            if (themeToggleBtn) {
                themeToggleBtn.addEventListener('click', function () {
                    const isDark = document.documentElement.classList.toggle('dark');
                    localStorage.setItem('theme', isDark ? 'dark' : 'light');
                    if (window.lucide) {
                        lucide.createIcons();
                    }
                });
            }


            // SignalR

    // ============================================
    // NOTIFICATION COUNT
    // ============================================

    function loadNotificationCount() {

        $.ajax({
            url: "/Notification/Count",
            type: "GET",

            success: function (count) {

                console.log("Notification count:", count);

                if (count > 0) {

                    $("#notificationBadge")
                        .text(count)
                        .removeClass("hidden");

                    $("#topNotificationBadge")
                        .text(count)
                        .removeClass("hidden")
                        .addClass("flex");

                }
                else {

                    $("#notificationBadge")
                        .addClass("hidden");

                    $("#topNotificationBadge")
                        .addClass("hidden")
                        .removeClass("flex");

                }
            },

            error: function (xhr) {

                console.error(
                    "Notification count error:",
                    xhr.status,
                    xhr.responseText
                );

            }
        });
    }


    // ============================================
    // SIGNALR
    // ============================================

    const connection =
        new signalR.HubConnectionBuilder()
            .withUrl("/hotelHub")
            .withAutomaticReconnect()
            .configureLogging(signalR.LogLevel.Information)
            .build();


    // ============================================
    // RECEIVE HOTEL UPDATED EVENT
    // ============================================

    connection.on("HotelUpdated", function () {

        console.log("HotelUpdated received.");

        loadNotificationCount();

    });


    // ============================================
    // CONNECTION START
    // ============================================

    async function startSignalR() {

        try {

            await connection.start();

            console.log("SignalR Connected.");

            loadNotificationCount();

        }
        catch (error) {

            console.error(
                "SignalR connection failed:",
                error
            );

            setTimeout(
                startSignalR,
                5000
            );

        }

    }


    // ============================================
    // RECONNECTED
    // ============================================

    connection.onreconnected(function () {

        console.log("SignalR Reconnected.");

        loadNotificationCount();

    });


    // ============================================
    // RECONNECTING
    // ============================================

    connection.onreconnecting(function (error) {

        console.log(
            "SignalR reconnecting...",
            error
        );

    });


    // ============================================
    // TOAST NOTIFICATIONS DISMISS LOGIC
    // ============================================

    function dismissGlobalToast(id) {
        const toast = document.getElementById(id);
        if (toast) {
            toast.style.opacity = '0';
            toast.style.transform = 'translateY(-10px)';
            setTimeout(() => toast.remove(), 300);
        }
    }

    document.addEventListener("DOMContentLoaded", function () {
        ['globalSuccessToast', 'globalErrorToast'].forEach(id => {
            const toast = document.getElementById(id);
            if (toast) {
                setTimeout(() => {
                    dismissGlobalToast(id);
                }, 3000);
            }
        });
    });

    // ============================================
    // START
    // ============================================

    startSignalR();

</script>
    


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>