@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - KS7 Hotel</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

    <script src="https://unpkg.com/lucide@latest"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet">


    <style>

            * {
                font-family: 'Inter', sans-serif;
            }

            body {
                background: #f7f8fc;
            }

            /* ================= SIDEBAR ================= */

            .sidebar {
                width: 260px;
            }

            .nav-item {
                position: relative;
                transition: all .25s ease;
            }

                .nav-item:hover {
                    background: #1e293b;
                    color: white;
                    transform: translateX(3px);
                }

                .nav-item.active {
                    background: linear-gradient( 135deg, #2563eb, #4f46e5 );
                    color: white;
                    box-shadow: 0 10px 25px rgba(37, 99, 235, .25);
                }

                    .nav-item.active::before {
                        content: "";
                        position: absolute;
                        left: 0;
                        top: 9px;
                        bottom: 9px;
                        width: 4px;
                        background: white;
                        border-radius: 0 5px 5px 0;
                    }


            /* ================= MAIN ================= */

            .main-content {
                margin-left: 260px;
                min-height: 100vh;
            }


            /* ================= PAGE ANIMATION ================= */

            .page-animation {
                animation: pageShow .35s ease;
            }

            @@keyframes pageShow {

                from {
                    opacity: 0;
                    transform: translateY(8px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }


            /* ================= CARDS ================= */

            .premium-card {
                background: white;
                border: 1px solid #eef0f5;
                border-radius: 18px;
                transition: all .3s ease;
            }

                .premium-card:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 15px 35px rgba(15,23,42,.08);
                }


            /* ================= BUTTON ================= */

            .premium-button {
                transition: all .25s ease;
            }

                .premium-button:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 8px 20px rgba(37,99,235,.25);
                }


            /* ================= TABLE ================= */

            .table-row {
                transition: all .2s ease;
            }

                .table-row:hover {
                    background: #f8fafc;
                }


            /* ================= SCROLL ================= */

            ::-webkit-scrollbar {
                width: 7px;
            }

            ::-webkit-scrollbar-track {
                background: #f1f5f9;
            }

            ::-webkit-scrollbar-thumb {
                background: #cbd5e1;
                border-radius: 10px;
            }


            /* ================= MOBILE ================= */

            @@media(max-width:900px) {

                .sidebar {
                    width: 80px;
                }

                .main-content {
                    margin-left: 80px;
                }

                .sidebar-text {
                    display: none;
                }

                .sidebar-logo-text {
                    display: none;
                }

                .nav-item {
                    justify-content: center;
                }
            }

    </style>

</head>


<body>


    <!-- ================================================= -->
    <!-- SIDEBAR -->
    <!-- ================================================= -->

    <aside class="sidebar fixed left-0 top-0 bottom-0
        bg-slate-950 text-slate-300 z-50">


        <!-- LOGO -->

        <div class="h-20 px-6 flex items-center
            border-b border-slate-800">

            <div class="w-10 h-10 rounded-xl
                bg-gradient-to-br from-blue-500 to-indigo-600
                flex items-center justify-center">

                <i data-lucide="hotel"
                   class="w-5 h-5 text-white">
                </i>

            </div>


            <div class="ml-3 sidebar-logo-text">

                <div class="text-white text-lg font-bold">

                    KS7 HOTEL

                </div>

                <div class="text-xs text-slate-500">

                    Booking Management

                </div>

            </div>

        </div>


        <!-- NAVIGATION -->

        <div class="p-4 overflow-y-auto
            h-[calc(100vh-80px)]">


            <!-- MAIN -->

            <div class="text-[11px] uppercase
                tracking-widest
                text-slate-600
                font-semibold
                px-3 mb-3 sidebar-text">

                Main

            </div>


            <nav class="space-y-2">


                <!-- DASHBOARD -->

                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="nav-item flex items-center gap-3
                    px-4 py-3 rounded-xl
                    @(currentController == "Dashboard" ? "active" : "")">

                    <i data-lucide="layout-dashboard"
                       class="w-5 h-5">
                    </i>

                    <span class="sidebar-text">

                        Dashboard

                    </span>

                </a>


                <!-- BOOKINGS -->

                <a asp-controller="Booking"
                   asp-action="Index"
                   class="nav-item flex items-center gap-3
                    px-4 py-3 rounded-xl
                    @(currentController == "Booking" ? "active" : "")">

                    <i data-lucide="calendar-check"
                       class="w-5 h-5">
                    </i>

                    <span class="sidebar-text">

                        Bookings

                    </span>

                </a>


                <!-- CHECK IN -->

                <a asp-controller="CheckIn"
                   asp-action="Index"
                   class="nav-item flex items-center gap-3
                    px-4 py-3 rounded-xl
                    @(currentController == "CheckIn" ? "active" : "")">

                    <i data-lucide="log-in"
                       class="w-5 h-5">
                    </i>

                    <span class="sidebar-text">

                        Check-in

                    </span>

                </a>


                <!-- CHECK OUT -->

                <a asp-controller="CheckOut"
                   asp-action="Index"
                   class="nav-item flex items-center gap-3
                    px-4 py-3 rounded-xl
                    @(currentController == "CheckOut" ? "active" : "")">

                    <i data-lucide="log-out"
                       class="w-5 h-5">
                    </i>

                    <span class="sidebar-text">

                        Check-out

                    </span>

                </a>

            </nav>


            <!-- MANAGEMENT -->

            <div class="text-[11px] uppercase
                tracking-widest
                text-slate-600
                font-semibold
                px-3 mt-8 mb-3 sidebar-text">

                Management

            </div>


            <nav class="space-y-2">


                <!-- CUSTOMER -->

                <a asp-controller="Customer"
                   asp-action="Index"
                   class="nav-item flex items-center gap-3
                    px-4 py-3 rounded-xl
                    @(currentController == "Customer" ? "active" : "")">

                    <i data-lucide="users"
                       class="w-5 h-5">
                    </i>

                    <span class="sidebar-text">

                        Customers

                    </span>

                </a>


                <!-- ROOM -->

                <a asp-controller="Room"
                   asp-action="Index"
                   class="nav-item flex items-center gap-3
                    px-4 py-3 rounded-xl
                    @(currentController == "Room" ? "active" : "")">

                    <i data-lucide="bed-double"
                       class="w-5 h-5">
                    </i>

                    <span class="sidebar-text">

                        Rooms

                    </span>

                </a>


                <!-- ROOM TYPE -->

                <a asp-controller="RoomType"
                   asp-action="Index"
                   class="nav-item flex items-center gap-3
                    px-4 py-3 rounded-xl
                    @(currentController == "RoomType" ? "active" : "")">

                    <i data-lucide="layers-3"
                       class="w-5 h-5">
                    </i>

                    <span class="sidebar-text">

                        Room Types

                    </span>

                </a>


                <!-- SERVICES -->

                <a asp-controller="Service"
                   asp-action="Index"
                   class="nav-item flex items-center gap-3
                    px-4 py-3 rounded-xl
                    @(currentController == "Service" ? "active" : "")">

                    <i data-lucide="concierge-bell"
                       class="w-5 h-5">
                    </i>

                    <span class="sidebar-text">

                        Services

                    </span>

                </a>

            </nav>


            <!-- FINANCE -->

            <div class="text-[11px] uppercase
                tracking-widest
                text-slate-600
                font-semibold
                px-3 mt-8 mb-3 sidebar-text">

                Finance

            </div>


            <nav class="space-y-2">


                <!-- PAYMENT -->

                <a asp-controller="Payment"
                   asp-action="Index"
                   class="nav-item flex items-center gap-3
                    px-4 py-3 rounded-xl
                    @(currentController == "Payment" ? "active" : "")">

                    <i data-lucide="credit-card"
                       class="w-5 h-5">
                    </i>

                    <span class="sidebar-text">

                        Payments

                    </span>

                </a>


                <!-- REPORT -->

                <a asp-controller="Report"
                   asp-action="Index"
                   class="nav-item flex items-center gap-3
                    px-4 py-3 rounded-xl
                    @(currentController == "Report" ? "active" : "")">

                    <i data-lucide="bar-chart-3"
                       class="w-5 h-5">
                    </i>

                    <span class="sidebar-text">

                        Reports

                    </span>

                </a>


                <!-- NOTIFICATION -->

                <a asp-controller="Notification"
                   asp-action="Index"
                   class="nav-item flex items-center gap-3
                    px-4 py-3 rounded-xl
                    @(currentController == "Notification" ? "active" : "")">

                    <i data-lucide="bell"
                       class="w-5 h-5">
                    </i>

                    <span class="sidebar-text">

                        Notifications

                    </span>

                    <span id="notificationBadge"
                          class="hidden ml-auto
                        bg-red-500 text-white
                        text-xs px-2 py-1
                        rounded-full">

                        0

                    </span>

                </a>

            </nav>

        </div>

    </aside>


    <!-- ================================================= -->
    <!-- MAIN CONTENT -->
    <!-- ================================================= -->

    <main class="main-content">


        <!-- TOP BAR -->

        <header class="h-20 bg-white
            border-b border-gray-100
            flex items-center justify-between
            px-8 sticky top-0 z-40">


            <div>

                <div class="text-xs text-gray-400">

                    KS7 Hotel

                </div>

                <div class="text-lg font-bold text-gray-800">

                    @ViewData["Title"]

                </div>

            </div>


            <div class="flex items-center gap-4">


                <!-- NOTIFICATION -->

                <a asp-controller="Notification"
                   asp-action="Index"
                   class="relative w-11 h-11
                    rounded-xl bg-gray-50
                    flex items-center justify-center
                    hover:bg-gray-100 transition">

                    <i data-lucide="bell"
                       class="w-5 h-5 text-gray-600">
                    </i>

                    <span id="topNotificationBadge"
                          class="hidden absolute -top-1 -right-1
                        min-w-[20px] h-5
                        bg-red-500 text-white
                        text-xs rounded-full
                        items-center justify-center">

                        0

                    </span>

                </a>


                <!-- DATE -->

                <div class="hidden md:flex
                    items-center gap-2
                    px-4 py-2
                    rounded-xl bg-gray-50">

                    <i data-lucide="calendar-days"
                       class="w-4 h-4 text-gray-500">
                    </i>

                    <span class="text-sm text-gray-600">

                        @DateTime.Now.ToString("dd MMM yyyy")

                    </span>

                </div>

            </div>

        </header>


        <!-- PAGE CONTENT -->

        <section class="p-8 page-animation">

            @RenderBody()

        </section>

    </main>


    <script>

            lucide.createIcons();


            // SignalR

            const connection =
                new signalR.HubConnectionBuilder()
                    .withUrl("/hotelHub")
                    .withAutomaticReconnect()
                    .build();


            connection.on("HotelUpdated", function() {

                loadNotificationCount();

            });


            connection.start()
                .then(function() {

                    loadNotificationCount();

                })
                .catch(function(error) {

                    console.log(error);

                });


            function loadNotificationCount() {

                $.get("/Notification/GetCount", function(data) {

                    if (data > 0) {

                        $("#notificationBadge")
                            .text(data)
                            .removeClass("hidden");

                        $("#topNotificationBadge")
                            .text(data)
                            .removeClass("hidden")
                            .addClass("flex");

                    }
                    else {

                        $("#notificationBadge")
                            .addClass("hidden");

                        $("#topNotificationBadge")
                            .addClass("hidden")
                            .removeClass("flex");

                    }

                });

            }

    </script>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>