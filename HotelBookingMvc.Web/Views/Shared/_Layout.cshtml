<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - Hotel Booking
    </title>

    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- SignalR -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>

</head>

<body class="bg-gray-100 text-gray-800">

    <div class="flex min-h-screen">

        <!-- SIDEBAR -->

        <aside class="w-64 bg-white border-r">

            <div class="p-6 border-b">

                <h1 class="text-xl font-bold text-gray-800">
                    Hotel Booking
                </h1>

                <p class="text-sm text-gray-500 mt-1">
                    Management System
                </p>

            </div>

            <nav class="p-4">

                <a href="/Dashboard"
                   class="flex items-center rounded-lg px-4 py-3
                          text-gray-700 hover:bg-gray-100">

                    📊
                    <span class="ml-3">
                        Dashboard
                    </span>

                </a>

                <a href="/Notification"
                   class="flex items-center rounded-lg px-4 py-3
                          text-gray-700 hover:bg-gray-100">

                    🔔
                    <span class="ml-3">
                        Notifications
                    </span>

                    <span id="notificationCount"
                          class="ml-auto rounded-full bg-red-500
                                 px-2 py-1 text-xs text-white">
                        0
                    </span>

                </a>


                <div class="mt-6">

                    <p class="px-4 mb-2 text-xs font-semibold
                              uppercase text-gray-400">
                        Reservation
                    </p>

                    <a href="/Booking"
                       class="flex items-center rounded-lg px-4 py-3
                              text-gray-700 hover:bg-gray-100">

                        📅
                        <span class="ml-3">
                            Bookings
                        </span>

                    </a>

                    <a href="/CheckIn"
                       class="flex items-center rounded-lg px-4 py-3
                              text-gray-700 hover:bg-gray-100">

                        🛎
                        <span class="ml-3">
                            Check-in
                        </span>

                    </a>

                    <a href="/CheckOut"
                       class="flex items-center rounded-lg px-4 py-3
                              text-gray-700 hover:bg-gray-100">

                        🚪
                        <span class="ml-3">
                            Check-out
                        </span>

                    </a>

                </div>


                <div class="mt-6">

                    <p class="px-4 mb-2 text-xs font-semibold
                              uppercase text-gray-400">
                        Guest Management
                    </p>

                    <a href="/Customer"
                       class="flex items-center rounded-lg px-4 py-3
                              text-gray-700 hover:bg-gray-100">

                        👤
                        <span class="ml-3">
                            Customers
                        </span>

                    </a>

                </div>


                <div class="mt-6">

                    <p class="px-4 mb-2 text-xs font-semibold
                              uppercase text-gray-400">
                        Hotel
                    </p>

                    <a href="/Room"
                       class="flex items-center rounded-lg px-4 py-3
                              text-gray-700 hover:bg-gray-100">

                        🛏
                        <span class="ml-3">
                            Rooms
                        </span>

                    </a>

                    <a href="/RoomType"
                       class="flex items-center rounded-lg px-4 py-3
                              text-gray-700 hover:bg-gray-100">

                        🏷
                        <span class="ml-3">
                            Room Types
                        </span>

                    </a>

                    <a href="/Service"
                       class="flex items-center rounded-lg px-4 py-3
                              text-gray-700 hover:bg-gray-100">

                        🧹
                        <span class="ml-3">
                            Services
                        </span>

                    </a>

                </div>


                <div class="mt-6">

                    <p class="px-4 mb-2 text-xs font-semibold
                              uppercase text-gray-400">
                        Finance
                    </p>

                    <a href="/Payment"
                       class="flex items-center rounded-lg px-4 py-3
                              text-gray-700 hover:bg-gray-100">

                        💳
                        <span class="ml-3">
                            Payments
                        </span>

                    </a>

                    <a href="/Report"
                       class="flex items-center rounded-lg px-4 py-3
                              text-gray-700 hover:bg-gray-100">

                        📊
                        <span class="ml-3">
                            Reports
                        </span>

                    </a>

                </div>

            </nav>

        </aside>


        <!-- MAIN -->

        <main class="flex-1">

            <!-- TOP BAR -->

            <header class="flex h-16 items-center justify-between
                           border-b bg-white px-6">

                <div>

                    <h2 class="font-semibold text-gray-800">
                        @ViewData["Title"]
                    </h2>

                </div>

                <button id="notificationButton"
                        class="rounded-lg px-4 py-2
                               hover:bg-gray-100">

                    🔔

                </button>

            </header>


            <!-- PAGE CONTENT -->

            <div>

                @RenderBody()

            </div>

        </main>

    </div>


    <!-- SignalR -->

    <script>

        const hotelConnection =
            new signalR.HubConnectionBuilder()
                .withUrl("/hotelHub")
                .withAutomaticReconnect()
                .build();


        hotelConnection.on("HotelUpdated", function () {

            console.log("Hotel data updated.");

            refreshNotificationCount();

        });


        hotelConnection.start()
            .then(function () {

                console.log("SignalR connected.");

                refreshNotificationCount();

            })
            .catch(function (error) {

                console.error(
                    "SignalR connection error:",
                    error
                );

            });


        function refreshNotificationCount() {

            $.get("/Notification/GetCount")
                .done(function (response) {

                    if (response && response.count !== undefined) {

                        $("#notificationCount")
                            .text(response.count);

                    }

                })
                .fail(function () {

                    console.log(
                        "Notification count is not available yet."
                    );

                });

        }

    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )

</body>

</html>