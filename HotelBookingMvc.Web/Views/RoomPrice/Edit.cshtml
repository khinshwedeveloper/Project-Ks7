@model Hotelbooking.Database.Models.TblRoomPrice

@{
    ViewData["Title"] = "Edit Room Price";
}

<div class="mx-auto max-w-2xl space-y-6">
    <div>
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">Edit Room Price</h1>
        <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Update pricing schedule information.</p>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.RoomPriceId" method="post"
          class="space-y-5 rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-6 sm:p-8 shadow-sm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="RoomPriceId" />
        <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800/60 text-rose-700 dark:text-rose-300 text-sm"></div>

        <div>
            <label asp-for="RoomTypeId" class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200">Room Type</label>
            <select asp-for="RoomTypeId" asp-items="ViewBag.RoomTypes"
                    class="w-full rounded-xl border border-slate-200 dark:border-slate-600 bg-slate-50 dark:bg-slate-900 p-3 text-slate-800 dark:text-white focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-indigo-500 outline-none transition">
                <option value="">-- Select Room Type --</option>
            </select>
            <span asp-validation-for="RoomTypeId" class="text-sm text-rose-500 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="PriceName" class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200">Price Name</label>
            <input asp-for="PriceName" class="w-full rounded-xl border border-slate-200 dark:border-slate-600 bg-slate-50 dark:bg-slate-900 p-3 text-slate-800 dark:text-white placeholder-slate-400 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-indigo-500 outline-none transition" />
            <span asp-validation-for="PriceName" class="text-sm text-rose-500 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="EffectiveDate" class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200">Effective Date</label>
            <input asp-for="EffectiveDate" type="date" asp-format="{0:yyyy-MM-dd}"
                   class="w-full rounded-xl border border-slate-200 dark:border-slate-600 bg-slate-50 dark:bg-slate-900 p-3 text-slate-800 dark:text-white focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-indigo-500 outline-none transition" />
            <span asp-validation-for="EffectiveDate" class="text-sm text-rose-500 mt-1 block"></span>
        </div>

        <div class="flex items-center gap-2 pt-1">
            <input asp-for="Status" type="checkbox" class="h-5 w-5 rounded border-slate-300 dark:border-slate-600 dark:bg-slate-900 text-indigo-600" />
            <label asp-for="Status" class="text-sm font-semibold text-slate-700 dark:text-slate-200 cursor-pointer">Active</label>
        </div>

        <div class="flex gap-3 pt-4 border-t border-slate-100 dark:border-slate-700/60">
            <button type="submit" class="rounded-xl bg-indigo-600 hover:bg-indigo-700 px-5 py-3 font-semibold text-white shadow-sm transition">
                Update Room Price
            </button>
            <a asp-action="Index" class="rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 px-5 py-3 font-medium transition">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
