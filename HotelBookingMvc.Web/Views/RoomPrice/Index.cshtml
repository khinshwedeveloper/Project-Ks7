@model IEnumerable<Hotelbooking.Database.Models.TblRoomPrice>

@{
    ViewData["Title"] = "Room Price Master";
}

<div class="max-w-7xl mx-auto space-y-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">
                Room Price Master
            </h1>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                Manage room pricing schedules and effective dates by room type.
            </p>
        </div>

        <a asp-action="Create"
           class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 px-5 py-3 font-semibold text-white shadow-sm transition">
            <i data-lucide="plus" class="w-4 h-4"></i>
            Create Room Price
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 p-4 text-emerald-800 dark:text-emerald-300 text-sm">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800/60 p-4 text-rose-800 dark:text-rose-300 text-sm">
            @TempData["Error"]
        </div>
    }

    <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-sm">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 dark:bg-slate-900/60 text-xs uppercase tracking-wider text-slate-600 dark:text-slate-400 border-b border-slate-200 dark:border-slate-700">
                <tr>
                    <th class="p-4">ID</th>
                    <th class="p-4">Price Name</th>
                    <th class="p-4">Room Type</th>
                    <th class="p-4">Effective Date</th>
                    <th class="p-4">Status</th>
                    <th class="p-4">Time Slots</th>
                    <th class="p-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-700/40 transition">
                        <td class="p-4 text-slate-500 dark:text-slate-400">@item.RoomPriceId</td>
                        <td class="p-4 font-semibold text-slate-900 dark:text-white">@item.PriceName</td>
                        <td class="p-4 text-slate-700 dark:text-slate-300">@item.RoomType?.RoomTypeName</td>
                        <td class="p-4 text-slate-600 dark:text-slate-300">@item.EffectiveDate.ToString("dd MMM yyyy")</td>
                        <td class="p-4">
                            @if (item.Status)
                            {
                                <span class="rounded-full bg-emerald-50 dark:bg-emerald-900/30 border border-emerald-200 dark:border-emerald-800/60 px-3 py-1 text-xs font-semibold text-emerald-700 dark:text-emerald-300">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="rounded-full bg-slate-100 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 px-3 py-1 text-xs font-semibold text-slate-600 dark:text-slate-300">
                                    Inactive
                                </span>
                            }
                        </td>
                        <td class="p-4">
                            <a asp-controller="RoomPriceDetail"
                               asp-action="Index"
                               asp-route-priceId="@item.RoomPriceId"
                               class="inline-flex items-center gap-1.5 font-semibold text-indigo-600 dark:text-indigo-400 hover:underline">
                                <i data-lucide="clock" class="w-4 h-4"></i>
                                Manage (@item.TblRoomPriceDetails.Count)
                            </a>
                        </td>
                        <td class="whitespace-nowrap p-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.RoomPriceId"
                                   class="px-3 py-1.5 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-300 hover:bg-indigo-600 hover:text-white dark:hover:bg-indigo-600 dark:hover:text-white text-xs font-medium transition">
                                    Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.RoomPriceId"
                                   class="px-3 py-1.5 rounded-lg bg-rose-50 dark:bg-rose-900/30 text-rose-600 dark:text-rose-300 hover:bg-rose-600 hover:text-white dark:hover:bg-rose-600 dark:hover:text-white text-xs font-medium transition">
                                    Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <p class="p-8 text-center text-slate-400 dark:text-slate-500">No room prices found. Create your first price setup.</p>
        }
    </div>
</div>
