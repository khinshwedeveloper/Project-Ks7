@model Hotelbooking.Database.Models.TblRoomStatus

@{
    ViewData["Title"] = "Delete Room Status";
}

<div class="max-w-2xl mx-auto space-y-6">

    <div class="mb-6">
        <h1 class="text-2xl sm:text-3xl font-bold text-rose-600 dark:text-rose-400">
            Delete Room Status
        </h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
            Please confirm before deleting this status.
        </p>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm p-6 sm:p-8">

        <div class="space-y-4 mb-6 divide-y divide-slate-100 dark:divide-slate-700/60 text-sm">
            <div class="pt-2 flex justify-between">
                <span class="text-slate-500 dark:text-slate-400 font-medium">Status Name</span>
                <span class="font-semibold text-slate-900 dark:text-white">@Model.StatusName</span>
            </div>

            <div class="pt-3 flex justify-between">
                <span class="text-slate-500 dark:text-slate-400 font-medium">Description</span>
                <span class="text-slate-800 dark:text-slate-200">@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</span>
            </div>

            <div class="pt-3 flex justify-between">
                <span class="text-slate-500 dark:text-slate-400 font-medium">Availability</span>
                <span class="font-semibold @(Model.IsAvailable ? "text-emerald-600 dark:text-emerald-400" : "text-slate-600 dark:text-slate-400")">
                    @(Model.IsAvailable ? "Available" : "Not Available")
                </span>
            </div>
        </div>

        <div class="p-4 mb-6 bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800/60 rounded-xl text-rose-700 dark:text-rose-300 text-sm">
            <strong>Warning:</strong> If this status is already assigned to a room, database constraints may prevent deletion.
        </div>

        <form asp-action="DeleteConfirmed" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.StatusId" />

            <div class="flex justify-end gap-3 pt-4 border-t border-slate-100 dark:border-slate-700/60">
                <a asp-action="Index"
                   class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 font-medium transition">
                    Cancel
                </a>

                <button type="submit"
                        class="px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-semibold shadow-sm transition">
                    Delete
                </button>
            </div>
        </form>

    </div>

</div>