@model List<Hotelbooking.Database.Models.TblService>

@{
    ViewData["Title"] = "Services";

    var serviceImages =
        ViewBag.ServiceImages as Dictionary<int, string>
        ?? new Dictionary<int, string>();

    int totalServices = Model.Count;

    int foodCount = Model.Count(x =>
        x.ServiceName.Contains("food",
            StringComparison.OrdinalIgnoreCase) ||
        x.ServiceName.Contains("burger",
            StringComparison.OrdinalIgnoreCase) ||
        x.ServiceName.Contains("pizza",
            StringComparison.OrdinalIgnoreCase) ||
        x.ServiceName.Contains("rice",
            StringComparison.OrdinalIgnoreCase) ||
        x.ServiceName.Contains("noodle",
            StringComparison.OrdinalIgnoreCase));

    decimal averagePrice = Model.Any()
        ? Model.Average(x => x.Price)
        : 0;

    decimal highestPrice = Model.Any()
        ? Model.Max(x => x.Price)
        : 0;
}


<div class="max-w-7xl mx-auto">


    <!-- PAGE HEADER -->
    <div class="flex flex-col md:flex-row
        md:items-center md:justify-between
        gap-4 mb-8">

        <div>

            <div class="flex items-center gap-2
                text-sm text-gray-400 mb-2">

                <i data-lucide="utensils"
                   class="w-4 h-4">
                </i>

                Hotel Services

            </div>


            <h1 class="text-3xl font-extrabold
                text-gray-900">

                Food & Drink Services

            </h1>


            <p class="text-gray-500 mt-1">

                Manage hotel food, drinks and guest services.

            </p>

        </div>


        <a asp-controller="Service"
           asp-action="Create"
           class="inline-flex items-center
            justify-center gap-2
            bg-blue-600 hover:bg-blue-700
            text-white px-5 py-3
            rounded-xl font-semibold
            shadow-lg shadow-blue-600/20
            transition">

            <i data-lucide="plus"
               class="w-5 h-5">
            </i>

            Add Service

        </a>

    </div>


    <!-- SUCCESS -->
    @if (TempData["Success"] != null)
    {
        <div class="premium-card mb-6 p-4
            flex items-center gap-3
            border-l-4 border-green-500">

            <div class="w-9 h-9 rounded-full
                bg-green-100
                flex items-center justify-center">

                <i data-lucide="check"
                   class="w-5 h-5 text-green-600">
                </i>

            </div>

            <div>

                <div class="font-semibold text-gray-800">
                    Success
                </div>

                <div class="text-sm text-gray-500">
                    @TempData["Success"]
                </div>

            </div>

        </div>
    }


    <!-- ERROR -->
    @if (TempData["Error"] != null)
    {
        <div class="premium-card mb-6 p-4
            flex items-center gap-3
            border-l-4 border-red-500">

            <div class="w-9 h-9 rounded-full
                bg-red-100
                flex items-center justify-center">

                <i data-lucide="alert-circle"
                   class="w-5 h-5 text-red-600">
                </i>

            </div>

            <div>

                <div class="font-semibold text-gray-800">
                    Error
                </div>

                <div class="text-sm text-gray-500">
                    @TempData["Error"]
                </div>

            </div>

        </div>
    }


    <!-- SUMMARY -->
    <div class="grid grid-cols-1
        sm:grid-cols-2
        lg:grid-cols-4
        gap-5 mb-8">


        <!-- TOTAL -->
        <div class="premium-card p-5">

            <div class="flex items-center
                justify-between">

                <div>

                    <p class="text-sm text-gray-500">
                        Total Services
                    </p>

                    <h2 class="text-3xl font-bold
                        text-gray-900 mt-2">

                        @totalServices

                    </h2>

                </div>

                <div class="w-12 h-12 rounded-xl
                    bg-blue-50
                    flex items-center
                    justify-center">

                    <i data-lucide="utensils"
                       class="w-6 h-6 text-blue-600">
                    </i>

                </div>

            </div>

        </div>


        <!-- FOOD -->
        <div class="premium-card p-5">

            <div class="flex items-center
                justify-between">

                <div>

                    <p class="text-sm text-gray-500">
                        Food Services
                    </p>

                    <h2 class="text-3xl font-bold
                        text-gray-900 mt-2">

                        @foodCount

                    </h2>

                </div>

                <div class="w-12 h-12 rounded-xl
                    bg-orange-50
                    flex items-center
                    justify-center">

                    <i data-lucide="sandwich"
                       class="w-6 h-6 text-orange-600">
                    </i>

                </div>

            </div>

        </div>


        <!-- AVERAGE -->
        <div class="premium-card p-5">

            <div class="flex items-center
                justify-between">

                <div>

                    <p class="text-sm text-gray-500">
                        Average Price
                    </p>

                    <h2 class="text-2xl font-bold
                        text-gray-900 mt-2">

                        @averagePrice.ToString("N0")

                    </h2>

                </div>

                <div class="w-12 h-12 rounded-xl
                    bg-green-50
                    flex items-center
                    justify-center">

                    <i data-lucide="banknote"
                       class="w-6 h-6 text-green-600">
                    </i>

                </div>

            </div>

        </div>


        <!-- HIGHEST -->
        <div class="premium-card p-5">

            <div class="flex items-center
                justify-between">

                <div>

                    <p class="text-sm text-gray-500">
                        Highest Price
                    </p>

                    <h2 class="text-2xl font-bold
                        text-gray-900 mt-2">

                        @highestPrice.ToString("N0")

                    </h2>

                </div>

                <div class="w-12 h-12 rounded-xl
                    bg-purple-50
                    flex items-center
                    justify-center">

                    <i data-lucide="trending-up"
                       class="w-6 h-6 text-purple-600">
                    </i>

                </div>

            </div>

        </div>

    </div>


    <!-- SERVICE SECTION -->
    <div class="premium-card overflow-hidden">


        <!-- HEADER -->
        <div class="px-6 py-5
            border-b border-gray-100
            flex flex-col md:flex-row
            md:items-center
            md:justify-between
            gap-4">

            <div>

                <h2 class="font-bold text-gray-800">
                    Food & Drink Menu
                </h2>

                <p class="text-sm text-gray-400 mt-1">
                    Available services for hotel guests.
                </p>

            </div>


            <!-- SEARCH -->
            <div class="relative">

                <i data-lucide="search"
                   class="absolute left-3 top-1/2
                    -translate-y-1/2
                    w-4 h-4 text-gray-400">
                </i>

                <input id="serviceSearch"
                       type="text"
                       placeholder="Search food or drink..."
                       class="w-full md:w-72
                pl-10 pr-4 py-2.5
                bg-gray-50
                border border-gray-200
                rounded-xl
                text-sm
                outline-none
                focus:ring-2
                focus:ring-blue-500
                focus:border-transparent">

            </div>

        </div>


        <!-- SERVICE GRID -->
        <div id="serviceGrid"
             class="p-6 grid grid-cols-1
            sm:grid-cols-2
            lg:grid-cols-3
            gap-6">


            @foreach (var item in Model)
            {
                serviceImages.TryGetValue(
                    item.ServiceId,
                    out string? imageUrl);


                <div class="service-card
                    group
                    rounded-2xl
                    border border-gray-100
                    bg-white
                    overflow-hidden
                    hover:shadow-xl
                    hover:-translate-y-1
                    transition-all duration-300">


                    <!-- IMAGE -->
                    <div class="relative h-52
                        bg-gray-100
                        overflow-hidden">


                        @if (!string.IsNullOrEmpty(imageUrl))
                        {
                            <img src="@imageUrl"
                                 alt="@item.ServiceName"
                                 class="w-full h-full
                            object-cover
                            group-hover:scale-105
                            transition duration-500" />
                        }
                        else
                        {
                            <div class="w-full h-full
                                flex flex-col
                                items-center
                                justify-center
                                bg-gradient-to-br
                                from-gray-50
                                to-gray-100">

                                <i data-lucide="image"
                                   class="w-12 h-12
                                    text-gray-300">
                                </i>

                                <span class="text-xs
                                    text-gray-400 mt-2">

                                    No Photo

                                </span>

                            </div>
                        }


                        <!-- PRICE -->
                        <div class="absolute top-3 right-3">

                            <span class="px-3 py-1.5
                                rounded-full
                                bg-white/95
                                backdrop-blur
                                text-gray-800
                                text-sm
                                font-bold
                                shadow">

                                @item.Price.ToString("N0")

                            </span>

                        </div>

                    </div>


                    <!-- CONTENT -->
                    <div class="p-5">


                        <div class="flex items-start
                            justify-between gap-3">

                            <div>

                                <h3 class="font-bold
                                    text-gray-800
                                    text-lg">

                                    @item.ServiceName

                                </h3>

                                <p class="text-xs
                                    text-gray-400 mt-1">

                                    Service #@item.ServiceId

                                </p>

                            </div>


                            <div class="w-9 h-9
                                rounded-lg
                                bg-blue-50
                                flex items-center
                                justify-center">

                                <i data-lucide="utensils"
                                   class="w-4 h-4
                                    text-blue-600">
                                </i>

                            </div>

                        </div>


                        <p class="text-sm text-gray-500
                            mt-3 line-clamp-2">

                            @(string.IsNullOrWhiteSpace(item.Description)
                                ? "No description available."
                                : item.Description)

                        </p>


                        <!-- ACTIONS -->
                        <div class="flex items-center
                            justify-between
                            mt-5 pt-4
                            border-t border-gray-100">


                            <span class="inline-flex
                                items-center gap-2
                                text-xs
                                font-medium
                                text-green-600">

                                <span class="w-2 h-2
                                    rounded-full
                                    bg-green-500">
                                </span>

                                Available

                            </span>


                            <div class="flex items-center gap-2">


                                <!-- EDIT -->
                                <a asp-controller="Service"
                                   asp-action="Edit"
                                   asp-route-id="@item.ServiceId"
                                   class="w-9 h-9 rounded-lg
                                    bg-blue-50
                                    text-blue-600
                                    flex items-center
                                    justify-center
                                    hover:bg-blue-600
                                    hover:text-white
                                    transition"
                                   title="Edit Service">

                                    <i data-lucide="pencil"
                                       class="w-4 h-4">
                                    </i>

                                </a>


                                <!-- DELETE -->
                                <form asp-controller="Service"
                                      asp-action="Delete"
                                      asp-route-id="@item.ServiceId"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            onclick="return confirm('Are you sure you want to delete this service?')"
                                            class="w-9 h-9 rounded-lg
                                        bg-red-50
                                        text-red-600
                                        flex items-center
                                        justify-center
                                        hover:bg-red-600
                                        hover:text-white
                                        transition"
                                            title="Delete Service">

                                        <i data-lucide="trash-2"
                                           class="w-4 h-4">
                                        </i>

                                    </button>

                                </form>

                            </div>

                        </div>

                    </div>

                </div>
            }


            <!-- EMPTY -->
            @if (!Model.Any())
            {
                <div class="col-span-full
                    text-center py-16">

                    <div class="w-16 h-16 mx-auto
                        rounded-2xl
                        bg-gray-100
                        flex items-center
                        justify-center">

                        <i data-lucide="utensils"
                           class="w-7 h-7
                            text-gray-400">
                        </i>

                    </div>

                    <h3 class="font-bold
                        text-gray-700 mt-4">

                        No Services

                    </h3>

                    <p class="text-sm
                        text-gray-400 mt-1">

                        Add your first food or drink service.

                    </p>

                    <a asp-controller="Service"
                       asp-action="Create"
                       class="inline-flex
                        items-center gap-2
                        mt-5 px-4 py-2.5
                        bg-blue-600
                        text-white
                        rounded-xl
                        font-medium
                        hover:bg-blue-700">

                        <i data-lucide="plus"
                           class="w-4 h-4">
                        </i>

                        Add Service

                    </a>

                </div>
            }

        </div>

    </div>

</div>


@section Scripts {

    <script>

        $("#serviceSearch").on("keyup", function () {

            const value =
                $(this).val().toLowerCase();

            $(".service-card").each(function () {

                const text =
                    $(this).text().toLowerCase();

                if (text.includes(value)) {
                    $(this).show();
                }
                else {
                    $(this).hide();
                }

            });

        });

    </script>

}