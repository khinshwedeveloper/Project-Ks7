@model Hotelbooking.Database.Models.TblService

@{
    ViewData["Title"] = "Add Service";
}

<div class="max-w-6xl mx-auto">

    <!-- PAGE HEADER -->
    <div class="mb-8">

        <div class="flex items-center gap-2 text-sm text-gray-400 mb-2">

            <i data-lucide="utensils" class="w-4 h-4"></i>

            Hotel Services

            <i data-lucide="chevron-right" class="w-4 h-4"></i>

            Add Service

        </div>

        <div class="flex flex-col md:flex-row
                    md:items-center md:justify-between gap-4">

            <div>

                <h1 class="text-3xl font-extrabold text-gray-900">
                    Add Food & Drink Service
                </h1>

                <p class="text-gray-500 mt-1">
                    Add a new food or drink service for hotel guests.
                </p>

            </div>

            <a asp-controller="Service"
               asp-action="Index"
               class="inline-flex items-center justify-center
                      gap-2 px-4 py-2.5 rounded-xl
                      border border-gray-200
                      bg-white text-gray-600
                      font-semibold
                      hover:bg-gray-50 transition">

                <i data-lucide="arrow-left" class="w-4 h-4"></i>

                Back to Services

            </a>

        </div>

    </div>


    <!-- MAIN CARD -->
    <div class="premium-card overflow-hidden">

        <!-- CARD HEADER -->
        <div class="px-6 py-5 border-b border-gray-100
                    flex items-center gap-4">

            <div class="w-12 h-12 rounded-xl
                        bg-blue-50
                        flex items-center justify-center">

                <i data-lucide="utensils"
                   class="w-6 h-6 text-blue-600">
                </i>

            </div>

            <div>

                <h2 class="font-bold text-gray-800">
                    Service Information
                </h2>

                <p class="text-sm text-gray-400 mt-1">
                    Add the service details and food photo.
                </p>

            </div>

        </div>


        <!-- FORM -->
        <form asp-controller="Service"
              asp-action="Create"
              method="post"
              enctype="multipart/form-data"
              class="p-6">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="mb-6 text-sm text-red-600">
            </div>


            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">


                <!-- LEFT SIDE -->
                <div class="space-y-6">


                    <!-- SERVICE NAME -->
                    <div>

                        <label asp-for="ServiceName"
                               class="block text-sm font-semibold
                                      text-gray-700 mb-2">

                            Service Name

                        </label>

                        <div class="relative">

                            <i data-lucide="utensils"
                               class="absolute left-3 top-1/2
                                      -translate-y-1/2
                                      w-5 h-5 text-gray-400">
                            </i>

                            <input asp-for="ServiceName"
                                   type="text"
                                   placeholder="Example: Chicken Burger"
                                   class="w-full pl-11 pr-4 py-3
                                          border border-gray-200
                                          rounded-xl
                                          bg-gray-50
                                          text-gray-800
                                          outline-none
                                          focus:bg-white
                                          focus:ring-2
                                          focus:ring-blue-500
                                          focus:border-transparent
                                          transition" />

                        </div>

                        <span asp-validation-for="ServiceName"
                              class="text-sm text-red-500">
                        </span>

                    </div>


                    <!-- PRICE -->
                    <div>

                        <label asp-for="Price"
                               class="block text-sm font-semibold
                                      text-gray-700 mb-2">

                            Price

                        </label>

                        <div class="relative">

                            <i data-lucide="banknote"
                               class="absolute left-3 top-1/2
                                      -translate-y-1/2
                                      w-5 h-5 text-gray-400">
                            </i>

                            <input asp-for="Price"
                                   type="number"
                                   min="0"
                                   step="0.01"
                                   placeholder="Example: 5000"
                                   class="w-full pl-11 pr-4 py-3
                                          border border-gray-200
                                          rounded-xl
                                          bg-gray-50
                                          text-gray-800
                                          outline-none
                                          focus:bg-white
                                          focus:ring-2
                                          focus:ring-blue-500
                                          focus:border-transparent
                                          transition" />

                        </div>

                        <span asp-validation-for="Price"
                              class="text-sm text-red-500">
                        </span>

                    </div>


                    <!-- DESCRIPTION -->
                    <div>

                        <label asp-for="Description"
                               class="block text-sm font-semibold
                                      text-gray-700 mb-2">

                            Description

                        </label>

                        <textarea asp-for="Description"
                                  rows="6"
                                  placeholder="Describe this food or drink service..."
                                  class="w-full px-4 py-3
                                         border border-gray-200
                                         rounded-xl
                                         bg-gray-50
                                         text-gray-800
                                         outline-none
                                         resize-none
                                         focus:bg-white
                                         focus:ring-2
                                         focus:ring-blue-500
                                         focus:border-transparent
                                         transition"></textarea>

                        <div class="flex justify-between mt-1">

                            <span asp-validation-for="Description"
                                  class="text-sm text-red-500">
                            </span>

                            <span id="descriptionCount"
                                  class="text-xs text-gray-400">
                                0 / 300
                            </span>

                        </div>

                    </div>


                </div>


                <!-- RIGHT SIDE PHOTO -->
                <div>

                    <label class="block text-sm font-semibold
                                  text-gray-700 mb-2">

                        Service Photo

                    </label>


                    <!-- DROP ZONE -->
                    <div id="dropZone"
                         class="relative min-h-[380px]
                                rounded-2xl
                                border-2 border-dashed
                                border-gray-300
                                bg-gray-50
                                hover:bg-blue-50/40
                                hover:border-blue-400
                                transition-all duration-300
                                cursor-pointer
                                overflow-hidden">


                        <!-- UPLOAD CONTENT -->
                        <div id="uploadContent"
                             class="absolute inset-0
                                    flex flex-col
                                    items-center
                                    justify-center
                                    p-8 text-center">

                            <div class="w-20 h-20 rounded-2xl
                                        bg-blue-50
                                        flex items-center
                                        justify-center
                                        mb-5">

                                <i data-lucide="cloud-upload"
                                   class="w-10 h-10 text-blue-600">
                                </i>

                            </div>


                            <h3 class="text-lg font-bold
                                       text-gray-700">

                                Drop your food photo here

                            </h3>


                            <p class="text-sm text-gray-400 mt-2">
                                or click to browse from your computer
                            </p>


                            <div class="mt-5 flex flex-wrap
                                        justify-center gap-2">

                                <span class="px-3 py-1
                                             rounded-full
                                             bg-white
                                             border border-gray-200
                                             text-xs text-gray-500">

                                    JPG

                                </span>

                                <span class="px-3 py-1
                                             rounded-full
                                             bg-white
                                             border border-gray-200
                                             text-xs text-gray-500">

                                    JPEG

                                </span>

                                <span class="px-3 py-1
                                             rounded-full
                                             bg-white
                                             border border-gray-200
                                             text-xs text-gray-500">

                                    PNG

                                </span>

                                <span class="px-3 py-1
                                             rounded-full
                                             bg-white
                                             border border-gray-200
                                             text-xs text-gray-500">

                                    WEBP

                                </span>

                            </div>


                            <p class="text-xs text-gray-400 mt-4">
                                Recommended: 800 × 600 or higher
                            </p>

                        </div>


                        <!-- IMAGE PREVIEW -->
                        <div id="previewContainer"
                             class="hidden absolute inset-0 bg-white">

                            <img id="imagePreview"
                                 src=""
                                 alt="Preview"
                                 class="w-full h-full object-cover" />


                            <!-- OVERLAY -->
                            <div class="absolute inset-0
                                        bg-black/0
                                        hover:bg-black/40
                                        transition
                                        flex items-center
                                        justify-center
                                        opacity-0
                                        hover:opacity-100">

                                <div class="text-center text-white">

                                    <i data-lucide="refresh-cw"
                                       class="w-8 h-8 mx-auto">
                                    </i>

                                    <p class="font-semibold mt-2">
                                        Change Photo
                                    </p>

                                </div>

                            </div>


                            <!-- REMOVE BUTTON -->
                            <button type="button"
                                    id="removePhoto"
                                    class="absolute top-4 right-4
                                           w-10 h-10 rounded-full
                                           bg-red-600 text-white
                                           flex items-center
                                           justify-center
                                           shadow-lg
                                           hover:bg-red-700
                                           transition">

                                <i data-lucide="x"
                                   class="w-5 h-5">
                                </i>

                            </button>

                        </div>


                        <!-- FILE INPUT -->
                        <input type="file"
                               id="Photo"
                               name="Photo"
                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                               class="hidden" />

                    </div>


                    <!-- PHOTO ERROR -->
                    <span id="photoError"
                          class="hidden text-sm text-red-500 mt-2">
                    </span>


                    <!-- PHOTO INFO -->
                    <div class="mt-4 p-4 rounded-xl
                                bg-blue-50
                                border border-blue-100
                                flex gap-3">

                        <i data-lucide="info"
                           class="w-5 h-5 text-blue-600
                                  flex-shrink-0 mt-0.5">
                        </i>

                        <div>

                            <p class="text-sm font-semibold
                                      text-blue-800">

                                Photo is stored separately

                            </p>

                            <p class="text-xs text-blue-600 mt-1">
                                The photo is saved in the website
                                image folder. It is not stored in
                                the database.
                            </p>

                        </div>

                    </div>

                </div>

            </div>


            <!-- BUTTONS -->
            <div class="mt-8 pt-6
                        border-t border-gray-100
                        flex flex-col-reverse sm:flex-row
                        sm:justify-end gap-3">

                <a asp-controller="Service"
                   asp-action="Index"
                   class="inline-flex items-center
                          justify-center gap-2
                          px-5 py-3 rounded-xl
                          border border-gray-200
                          bg-white text-gray-600
                          font-semibold
                          hover:bg-gray-50 transition">

                    Cancel

                </a>


                <button type="submit"
                        class="inline-flex items-center
                               justify-center gap-2
                               px-5 py-3 rounded-xl
                               bg-blue-600
                               hover:bg-blue-700
                               text-white
                               font-semibold
                               shadow-lg
                               shadow-blue-600/20
                               transition">

                    <i data-lucide="plus"
                       class="w-5 h-5">
                    </i>

                    Create Service

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <script>

        const dropZone =
            document.getElementById("dropZone");

        const fileInput =
            document.getElementById("Photo");

        const previewContainer =
            document.getElementById("previewContainer");

        const uploadContent =
            document.getElementById("uploadContent");

        const imagePreview =
            document.getElementById("imagePreview");

        const removePhoto =
            document.getElementById("removePhoto");

        const photoError =
            document.getElementById("photoError");


        const allowedTypes = [
            "image/jpeg",
            "image/png",
            "image/webp"
        ];


        // Click
        dropZone.addEventListener("click", function (e) {

            if (e.target.closest("#removePhoto"))
                return;

            fileInput.click();

        });


        // File selected
        fileInput.addEventListener("change", function () {

            if (this.files.length > 0) {

                handleFile(this.files[0]);

            }

        });


        // Drag over
        dropZone.addEventListener("dragover", function (e) {

            e.preventDefault();

            dropZone.classList.add(
                "border-blue-500",
                "bg-blue-50"
            );

        });


        // Drag leave
        dropZone.addEventListener("dragleave", function () {

            dropZone.classList.remove(
                "border-blue-500",
                "bg-blue-50"
            );

        });


        // Drop
        dropZone.addEventListener("drop", function (e) {

            e.preventDefault();

            dropZone.classList.remove(
                "border-blue-500",
                "bg-blue-50"
            );


            if (e.dataTransfer.files.length > 0) {

                const file =
                    e.dataTransfer.files[0];

                handleFile(file);

            }

        });


        // Handle file
        function handleFile(file) {

            photoError.classList.add("hidden");
            photoError.textContent = "";


            if (!allowedTypes.includes(file.type)) {

                showPhotoError(
                    "Please select JPG, JPEG, PNG or WEBP image."
                );

                return;

            }


            // 5 MB limit
            if (file.size > 5 * 1024 * 1024) {

                showPhotoError(
                    "Image size must be less than 5 MB."
                );

                return;

            }


            // Put dropped file into input
            try {

                const dataTransfer =
                    new DataTransfer();

                dataTransfer.items.add(file);

                fileInput.files =
                    dataTransfer.files;

            }
            catch (error) {

                console.log(error);

            }


            // Preview
            const reader =
                new FileReader();

            reader.onload = function (e) {

                imagePreview.src =
                    e.target.result;

                uploadContent.classList.add("hidden");

                previewContainer.classList.remove("hidden");

            };

            reader.readAsDataURL(file);

        }


        // Remove
        removePhoto.addEventListener("click", function (e) {

            e.stopPropagation();

            fileInput.value = "";

            imagePreview.src = "";

            previewContainer.classList.add("hidden");

            uploadContent.classList.remove("hidden");

        });


        // Error
        function showPhotoError(message) {

            photoError.textContent = message;

            photoError.classList.remove("hidden");

            fileInput.value = "";

            imagePreview.src = "";

            previewContainer.classList.add("hidden");

            uploadContent.classList.remove("hidden");

        }


        // Description counter
        const description =
            document.getElementById("Description");

        const descriptionCount =
            document.getElementById("descriptionCount");


        if (description) {

            description.addEventListener("input", function () {

                descriptionCount.textContent =
                    `${this.value.length} / 300`;

            });

        }

    </script>
}