@model IEnumerable<HotelBookingMvc.Web.ViewModels.CheckInViewModel>

@{
    ViewData["Title"] = "Check-in";

    var total = Model.Count();
}

<div class="w-full">

    <!-- Header -->
    <div class="flex flex-col lg:flex-row
                lg:items-center
                lg:justify-between
                gap-5 mb-7">

        <div>

            <div class="flex items-center gap-2
                        text-sm
                        text-slate-500
                        dark:text-slate-400 mb-2">

                <i data-lucide="log-in"
                   class="w-4 h-4"></i>

                <span>Front Office</span>

            </div>

            <h1 class="text-3xl font-bold
                       text-slate-900
                       dark:text-white">

                Check-in

            </h1>

            <p class="text-slate-500
                      dark:text-slate-400 mt-1">

                Check in confirmed guests and assign occupied rooms.

            </p>

        </div>


        <!-- Today's date -->
        <div class="flex items-center gap-3
                    px-4 py-3
                    rounded-xl
                    bg-white
                    dark:bg-slate-800
                    border border-slate-200
                    dark:border-slate-700">

            <div class="w-10 h-10
                        rounded-lg
                        bg-blue-50
                        dark:bg-blue-900/30
                        flex items-center
                        justify-center">

                <i data-lucide="calendar-days"
                   class="w-5 h-5
                          text-blue-600
                          dark:text-blue-400"></i>

            </div>

            <div>

                <p class="text-xs
                          text-slate-400">

                    Today

                </p>

                <p class="font-semibold
                          text-slate-800
                          dark:text-white">

                    @DateTime.Today.ToString("dd MMM yyyy")

                </p>

            </div>

        </div>

    </div>


    <!-- Summary -->
    <div class="grid grid-cols-1
                sm:grid-cols-2
                gap-5 mb-7">

        <div class="bg-white
                    dark:bg-slate-800
                    border border-slate-200
                    dark:border-slate-700
                    rounded-2xl
                    p-5
                    shadow-sm">

            <div class="flex items-center
                        justify-between">

                <div>

                    <p class="text-sm
                              font-medium
                              text-slate-500
                              dark:text-slate-400">

                        Ready for Check-in

                    </p>

                    <p class="text-3xl
                              font-bold
                              text-slate-900
                              dark:text-white mt-2">

                        @total

                    </p>

                </div>

                <div class="w-12 h-12
                            rounded-xl
                            bg-blue-50
                            dark:bg-blue-900/30
                            flex items-center
                            justify-center">

                    <i data-lucide="log-in"
                       class="w-6 h-6
                              text-blue-600
                              dark:text-blue-400"></i>

                </div>

            </div>

        </div>


        <div class="bg-white
                    dark:bg-slate-800
                    border border-slate-200
                    dark:border-slate-700
                    rounded-2xl
                    p-5
                    shadow-sm">

            <div class="flex items-center
                        justify-between">

                <div>

                    <p class="text-sm
                              font-medium
                              text-slate-500
                              dark:text-slate-400">

                        Process

                    </p>

                    <p class="text-lg
                              font-bold
                              text-emerald-600
                              dark:text-emerald-400 mt-2">

                        Confirmed → Checked-in

                    </p>

                </div>

                <div class="w-12 h-12
                            rounded-xl
                            bg-emerald-50
                            dark:bg-emerald-900/30
                            flex items-center
                            justify-center">

                    <i data-lucide="badge-check"
                       class="w-6 h-6
                              text-emerald-600
                              dark:text-emerald-400"></i>

                </div>

            </div>

        </div>

    </div>


    <!-- Search + Table -->
    <div class="bg-white
                dark:bg-slate-800
                border border-slate-200
                dark:border-slate-700
                rounded-2xl
                shadow-sm
                overflow-hidden">


        <!-- Search -->
        <div class="p-5
                    border-b
                    border-slate-200
                    dark:border-slate-700">

            <div class="relative max-w-lg">

                <i data-lucide="search"
                   class="absolute left-4 top-1/2
                          -translate-y-1/2
                          w-5 h-5
                          text-slate-400"></i>

                <input id="checkInSearch"
                       type="text"
                       placeholder="Search booking, customer or room..."
                       class="w-full
                              pl-11 pr-4 py-3
                              rounded-xl
                              border border-slate-200
                              dark:border-slate-600
                              bg-slate-50
                              dark:bg-slate-900
                              text-slate-800
                              dark:text-white
                              placeholder-slate-400
                              outline-none
                              focus:ring-2
                              focus:ring-blue-500/20
                              transition" />

            </div>

        </div>


        <!-- Table -->
        <div class="overflow-x-auto">

            <table class="w-full">

                <thead class="bg-slate-50
                              dark:bg-slate-900
                              border-b
                              border-slate-200
                              dark:border-slate-700">

                    <tr>

                        <th class="px-6 py-4
                                   text-left
                                   text-xs
                                   font-bold
                                   uppercase
                                   tracking-wider
                                   text-slate-500
                                   dark:text-slate-400">

                            Booking

                        </th>

                        <th class="px-6 py-4
                                   text-left
                                   text-xs
                                   font-bold
                                   uppercase
                                   tracking-wider
                                   text-slate-500
                                   dark:text-slate-400">

                            Guest

                        </th>

                        <th class="px-6 py-4
                                   text-left
                                   text-xs
                                   font-bold
                                   uppercase
                                   tracking-wider
                                   text-slate-500
                                   dark:text-slate-400">

                            Room

                        </th>

                        <th class="px-6 py-4
                                   text-left
                                   text-xs
                                   font-bold
                                   uppercase
                                   tracking-wider
                                   text-slate-500
                                   dark:text-slate-400">

                            Stay

                        </th>

                        <th class="px-6 py-4
                                   text-left
                                   text-xs
                                   font-bold
                                   uppercase
                                   tracking-wider
                                   text-slate-500
                                   dark:text-slate-400">

                            Total

                        </th>

                        <th class="px-6 py-4
                                   text-right
                                   text-xs
                                   font-bold
                                   uppercase
                                   tracking-wider
                                   text-slate-500
                                   dark:text-slate-400">

                            Action

                        </th>

                    </tr>

                </thead>


                <tbody id="checkInTable"
                       class="divide-y
                              divide-slate-100
                              dark:divide-slate-700">

                    @foreach (var item in Model)
                    {
                        <tr class="checkin-row
                                   bg-white
                                   dark:bg-slate-800
                                   hover:bg-slate-50
                                   dark:hover:bg-slate-700/60
                                   transition">


                            <!-- Booking -->
                            <td class="px-6 py-5">

                                <p class="font-bold
                                          text-slate-900
                                          dark:text-white">

                                    @item.BookingNo

                                </p>

                                <p class="text-xs
                                          text-slate-400
                                          mt-1">

                                    Booking ID:
                                    @item.BookingId

                                </p>

                            </td>


                            <!-- Guest -->
                            <td class="px-6 py-5">

                                <div class="flex items-center gap-3">

                                    <div class="w-10 h-10
                                                rounded-xl
                                                bg-blue-50
                                                dark:bg-blue-900/30
                                                flex items-center
                                                justify-center">

                                        <i data-lucide="user"
                                           class="w-5 h-5
                                                  text-blue-600
                                                  dark:text-blue-400"></i>

                                    </div>

                                    <div>

                                        <p class="font-semibold
                                                  text-slate-800
                                                  dark:text-white">

                                            @item.CustomerName

                                        </p>

                                        <p class="text-xs
                                                  text-slate-400
                                                  mt-1">

                                            @item.CustomerPhone

                                        </p>

                                    </div>

                                </div>

                            </td>


                            <!-- Room -->
                            <td class="px-6 py-5">

                                <div class="flex items-center gap-2">

                                    <i data-lucide="bed-double"
                                       class="w-5 h-5
                                              text-slate-400"></i>

                                    <span class="font-semibold
                                                 text-slate-800
                                                 dark:text-white">

                                        Room @item.RoomNumber

                                    </span>

                                </div>

                            </td>


                            <!-- Stay -->
                            <td class="px-6 py-5">

                                <p class="text-sm
                                          font-medium
                                          text-slate-700
                                          dark:text-slate-200">

                                    @item.CheckInDate.ToString("dd MMM yyyy")

                                </p>

                                <div class="flex items-center gap-1
                                            text-xs
                                            text-slate-400 mt-1">

                                    <span>to</span>

                                    <span>
                                        @item.CheckOutDate.ToString("dd MMM yyyy")
                                    </span>

                                </div>

                            </td>


                            <!-- Total -->
                            <td class="px-6 py-5">

                                <p class="font-bold
                                          text-slate-900
                                          dark:text-white">

                                    @item.TotalAmount.ToString("N2")

                                </p>

                                <p class="text-xs
                                          text-slate-400">

                                    MMK

                                </p>

                            </td>


                            <!-- Action -->
                            <td class="px-6 py-5">

                                <div class="flex
                                            justify-end">

                                    <form asp-action="CheckIn"
                                          method="post"
                                          onsubmit="return confirm('Check in this guest?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.BookingId" />

                                        <button type="submit"
                                                class="inline-flex
                                                       items-center
                                                       gap-2
                                                       px-4 py-2.5
                                                       rounded-xl
                                                       bg-emerald-600
                                                       hover:bg-emerald-700
                                                       dark:bg-emerald-600
                                                       dark:hover:bg-emerald-500
                                                       text-white
                                                       font-semibold
                                                       shadow-sm
                                                       transition">

                                            <i data-lucide="log-in"
                                               class="w-4 h-4"></i>

                                            Check-in

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!-- Empty -->
        @if (!Model.Any())
        {
            <div class="py-16 text-center">

                <div class="w-16 h-16
                            mx-auto
                            rounded-2xl
                            bg-slate-100
                            dark:bg-slate-700
                            flex items-center
                            justify-center">

                    <i data-lucide="calendar-check"
                       class="w-8 h-8
                              text-slate-400"></i>

                </div>

                <h3 class="text-lg
                           font-bold
                           text-slate-800
                           dark:text-white mt-4">

                    No guests ready for check-in

                </h3>

                <p class="text-sm
                          text-slate-500
                          dark:text-slate-400 mt-1">

                    Confirmed bookings for today will appear here.

                </p>

            </div>
        }

    </div>

</div>


@section Scripts {

<script>

    lucide.createIcons();

    $("#checkInSearch").on("keyup", function () {

        const value =
            $(this).val().toLowerCase();

        $(".checkin-row").each(function () {

            const text =
                $(this).text().toLowerCase();

            $(this).toggle(
                text.includes(value)
            );

        });

    });

</script>

}