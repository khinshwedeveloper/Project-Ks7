@model List<Hotelbooking.Database.Models.TblRoomType>

@{
    ViewData["Title"] = "Room Types";
}

<div class="max-w-7xl mx-auto space-y-8">

    <!-- PAGE HEADER -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-sm text-slate-400 dark:text-slate-400 mb-2">
                <i data-lucide="settings-2" class="w-4 h-4 text-blue-500"></i>
                <span>Room Management</span>
            </div>

            <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
                Room Types
            </h1>

            <p class="text-slate-500 dark:text-slate-400 mt-1">
                Manage your hotel's room categories, capacities, and descriptions.
            </p>
        </div>

        <a asp-controller="RoomType"
           asp-action="Create"
           class="inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-5 py-3 rounded-xl font-semibold shadow-lg shadow-blue-600/20 transition">
            <i data-lucide="plus" class="w-5 h-5"></i>
            Add Room Type
        </a>
    </div>

    <!-- SUMMARY CARDS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <!-- TOTAL -->
        <div class="premium-card p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Total Room Types</p>
                    <h2 class="text-3xl font-bold text-slate-900 dark:text-white mt-2">@Model.Count</h2>
                </div>
                <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-950/60 flex items-center justify-center">
                    <i data-lucide="layers-3" class="w-6 h-6 text-blue-600 dark:text-blue-400"></i>
                </div>
            </div>
        </div>

        <!-- ACTIVE -->
        <div class="premium-card p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Active Types</p>
                    <h2 class="text-3xl font-bold text-slate-900 dark:text-white mt-2">@Model.Count(x => x.Status)</h2>
                </div>
                <div class="w-12 h-12 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 flex items-center justify-center">
                    <i data-lucide="check-circle" class="w-6 h-6 text-emerald-600 dark:text-emerald-400"></i>
                </div>
            </div>
        </div>

        <!-- INACTIVE -->
        <div class="premium-card p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Inactive Types</p>
                    <h2 class="text-3xl font-bold text-slate-900 dark:text-white mt-2">@Model.Count(x => !x.Status)</h2>
                </div>
                <div class="w-12 h-12 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center">
                    <i data-lucide="power" class="w-6 h-6 text-slate-600 dark:text-slate-400"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- TABLE CARD -->
    <div class="premium-card overflow-hidden">
        <!-- TABLE HEADER -->
        <div class="px-6 py-5 border-b border-slate-100 dark:border-slate-700/60 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
                <h2 class="font-bold text-slate-900 dark:text-white">All Room Types</h2>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">View and manage room categories.</p>
            </div>

            <!-- SEARCH -->
            <div class="relative">
                <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                <input id="roomTypeSearch"
                       type="text"
                       placeholder="Search room type..."
                       class="w-full md:w-64 pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-800 dark:text-white placeholder-slate-400 outline-none focus:ring-2 focus:ring-blue-500 transition" />
            </div>
        </div>

        <!-- TABLE -->
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="bg-slate-50 dark:bg-slate-900/60 text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 border-b border-slate-100 dark:border-slate-700/60">
                        <th class="px-6 py-4 text-left">#</th>
                        <th class="px-6 py-4 text-left">Room Type</th>
                        <th class="px-6 py-4 text-left">Description</th>
                        <th class="px-6 py-4 text-left">Max Guests</th>
                        <th class="px-6 py-4 text-left">Status</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>

                <tbody id="roomTypeTable" class="divide-y divide-slate-100 dark:divide-slate-700/60">
                    @{
                        int count = 1;
                    }

                    @foreach (var item in Model)
                    {
                        <tr class="table-row room-type-row hover:bg-slate-50/80 dark:hover:bg-slate-700/40 transition">
                            <!-- NUMBER -->
                            <td class="px-6 py-5 text-sm text-slate-400 dark:text-slate-500">
                                @count
                            </td>

                            <!-- NAME -->
                            <td class="px-6 py-5">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/60 flex items-center justify-center">
                                        <i data-lucide="bed-double" class="w-5 h-5 text-blue-600 dark:text-blue-400"></i>
                                    </div>
                                    <div>
                                        <div class="font-semibold text-slate-900 dark:text-white">
                                            @item.RoomTypeName
                                        </div>
                                        <div class="text-xs text-slate-400 dark:text-slate-500">
                                            Type #@item.RoomTypeId
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <!-- DESCRIPTION -->
                            <td class="px-6 py-5 text-sm text-slate-600 dark:text-slate-300">
                                @(string.IsNullOrWhiteSpace(item.Description) ? "No description" : item.Description)
                            </td>

                            <!-- MAX GUESTS -->
                            <td class="px-6 py-5">
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-semibold">
                                    <i data-lucide="users" class="w-3.5 h-3.5 text-slate-500 dark:text-slate-400"></i>
                                    @item.MaxGuest @(item.MaxGuest > 1 ? "Guests" : "Guest")
                                </span>
                            </td>

                            <!-- STATUS -->
                            <td class="px-6 py-5">
                                @if (item.Status)
                                {
                                    <span class="inline-flex items-center px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/60 text-xs font-semibold">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-600 text-xs font-semibold">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <!-- ACTIONS -->
                            <td class="px-6 py-5 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a asp-controller="RoomType"
                                       asp-action="Edit"
                                       asp-route-id="@item.RoomTypeId"
                                       class="w-9 h-9 rounded-lg bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-300 flex items-center justify-center hover:bg-blue-600 hover:text-white dark:hover:bg-blue-600 dark:hover:text-white transition"
                                       title="Edit Room Type">
                                        <i data-lucide="pencil" class="w-4 h-4"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>

                        count++;
                    }

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-16 text-center">
                                <div class="w-16 h-16 mx-auto rounded-2xl bg-slate-100 dark:bg-slate-700 flex items-center justify-center mb-4">
                                    <i data-lucide="bed-double" class="w-7 h-7 text-slate-400"></i>
                                </div>
                                <h3 class="font-bold text-slate-800 dark:text-white">No Room Types</h3>
                                <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 mb-5">Create your first room type category.</p>
                                <a asp-controller="RoomType" asp-action="Create" class="inline-flex items-center gap-2 bg-blue-600 text-white px-4 py-2.5 rounded-xl font-medium hover:bg-blue-700">
                                    <i data-lucide="plus" class="w-4 h-4"></i> Add Room Type
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $("#roomTypeSearch").on("keyup", function() {
            const searchValue = $(this).val().toLowerCase();
            $(".room-type-row").each(function() {
                const rowText = $(this).text().toLowerCase();
                if (rowText.includes(searchValue)) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        });
    </script>
}