@model List<Hotelbooking.Database.Models.TblRoomType>

@{
    ViewData["Title"] = "Room Types";
}

<div class="max-w-7xl mx-auto">


    <!-- ================================================= -->
    <!-- PAGE HEADER -->
    <!-- ================================================= -->

    <div class="flex flex-col md:flex-row
        md:items-center md:justify-between
        gap-4 mb-8">


        <div>

            <div class="flex items-center gap-2
                text-sm text-gray-400 mb-2">

                <i data-lucide="settings-2"
                   class="w-4 h-4">
                </i>

                Room Management

            </div>


            <h1 class="text-3xl font-extrabold
                text-gray-900">

                Room Types

            </h1>


            <p class="text-gray-500 mt-1">

                Manage your hotel's room categories
                and pricing.

            </p>

        </div>


        <a asp-controller="RoomType"
           asp-action="Create"
           class="premium-button
            inline-flex items-center
            justify-center gap-2
            bg-blue-600 hover:bg-blue-700
            text-white
            px-5 py-3
            rounded-xl
            font-semibold
            shadow-lg shadow-blue-600/20">

            <i data-lucide="plus"
               class="w-5 h-5">
            </i>

            Add Room Type

        </a>

    </div>


    <!-- ================================================= -->
    <!-- ALERT -->
    <!-- ================================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="premium-card
            mb-6 p-4
            flex items-center gap-3
            border-l-4 border-green-500">

            <div class="w-9 h-9 rounded-full
                bg-green-100
                flex items-center justify-center">

                <i data-lucide="check"
                   class="w-5 h-5 text-green-600">
                </i>

            </div>

            <div>

                <div class="font-semibold text-gray-800">
                    Success
                </div>

                <div class="text-sm text-gray-500">
                    @TempData["Success"]
                </div>

            </div>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="premium-card
            mb-6 p-4
            flex items-center gap-3
            border-l-4 border-red-500">

            <div class="w-9 h-9 rounded-full
                bg-red-100
                flex items-center justify-center">

                <i data-lucide="alert-circle"
                   class="w-5 h-5 text-red-600">
                </i>

            </div>

            <div>

                <div class="font-semibold text-gray-800">
                    Error
                </div>

                <div class="text-sm text-gray-500">
                    @TempData["Error"]
                </div>

            </div>

        </div>
    }


    <!-- ================================================= -->
    <!-- SUMMARY CARDS -->
    <!-- ================================================= -->

    <div class="grid grid-cols-1
        sm:grid-cols-2
        lg:grid-cols-3
        gap-5 mb-8">


        <!-- TOTAL -->

        <div class="premium-card p-5">

            <div class="flex items-center
                justify-between">

                <div>

                    <p class="text-sm text-gray-500">
                        Total Room Types
                    </p>

                    <h2 class="text-3xl font-bold
                        text-gray-900 mt-2">

                        @Model.Count

                    </h2>

                </div>


                <div class="w-12 h-12
                    rounded-xl
                    bg-blue-50
                    flex items-center
                    justify-center">

                    <i data-lucide="layers-3"
                       class="w-6 h-6 text-blue-600">
                    </i>

                </div>

            </div>

        </div>


        <!-- AVERAGE PRICE -->

        <div class="premium-card p-5">

            <div class="flex items-center
                justify-between">

                <div>

                    <p class="text-sm text-gray-500">
                        Average Price / Night
                    </p>

                    <h2 class="text-2xl font-bold
                        text-gray-900 mt-2">

                        @(Model.Any()
                            ? Model.Average(x => x.PricePerNight).ToString("N0")
                            : "0")

                    </h2>

                </div>


                <div class="w-12 h-12
                    rounded-xl
                    bg-emerald-50
                    flex items-center
                    justify-center">

                    <i data-lucide="banknote"
                       class="w-6 h-6 text-emerald-600">
                    </i>

                </div>

            </div>

        </div>


        <!-- HIGHEST PRICE -->

        <div class="premium-card p-5">

            <div class="flex items-center
                justify-between">

                <div>

                    <p class="text-sm text-gray-500">
                        Highest Price
                    </p>

                    <h2 class="text-2xl font-bold
                        text-gray-900 mt-2">

                        @(Model.Any()
                            ? Model.Max(x => x.PricePerNight).ToString("N0")
                            : "0")

                    </h2>

                </div>


                <div class="w-12 h-12
                    rounded-xl
                    bg-violet-50
                    flex items-center
                    justify-center">

                    <i data-lucide="trending-up"
                       class="w-6 h-6 text-violet-600">
                    </i>

                </div>

            </div>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- TABLE CARD -->
    <!-- ================================================= -->

    <div class="premium-card overflow-hidden">


        <!-- TABLE HEADER -->

        <div class="px-6 py-5
            border-b border-gray-100
            flex flex-col md:flex-row
            md:items-center
            md:justify-between
            gap-4">


            <div>

                <h2 class="font-bold text-gray-800">

                    All Room Types

                </h2>

                <p class="text-sm text-gray-400 mt-1">

                    View and manage room categories.

                </p>

            </div>


            <!-- SEARCH -->

            <div class="relative">

                <i data-lucide="search"
                   class="absolute left-3 top-1/2
                    -translate-y-1/2
                    w-4 h-4 text-gray-400">
                </i>

                <input id="roomTypeSearch"
                       type="text"
                       placeholder="Search room type..."
                       class="w-full md:w-64
                pl-10 pr-4 py-2.5
                bg-gray-50
                border border-gray-200
                rounded-xl
                text-sm
                outline-none
                focus:ring-2
                focus:ring-blue-500
                focus:border-transparent">

            </div>

        </div>


        <!-- TABLE -->

        <div class="overflow-x-auto">

            <table class="w-full">

                <thead>

                    <tr class="bg-gray-50
                        text-xs uppercase
                        tracking-wider
                        text-gray-400">

                        <th class="px-6 py-4 text-left">
                            #
                        </th>

                        <th class="px-6 py-4 text-left">
                            Room Type
                        </th>

                        <th class="px-6 py-4 text-left">
                            Description
                        </th>

                        <th class="px-6 py-4 text-left">
                            Price / Night
                        </th>

                        <th class="px-6 py-4 text-left">
                            Status
                        </th>

                        <th class="px-6 py-4 text-right">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody id="roomTypeTable">

                    @{
                        int count = 1;
                    }


                    @foreach (var item in Model)
                    {
                        <tr class="table-row border-t
                            border-gray-100 room-type-row">


                            <!-- NUMBER -->

                            <td class="px-6 py-5
                                text-sm text-gray-400">

                                @count

                            </td>


                            <!-- NAME -->

                            <td class="px-6 py-5">

                                <div class="flex items-center gap-3">


                                    <div class="w-10 h-10
                                        rounded-xl
                                        bg-blue-50
                                        flex items-center
                                        justify-center">

                                        <i data-lucide="bed-double"
                                           class="w-5 h-5
                                            text-blue-600">
                                        </i>

                                    </div>


                                    <div>

                                        <div class="font-semibold
                                            text-gray-800">

                                            @item.RoomTypeName

                                        </div>

                                        <div class="text-xs
                                            text-gray-400">

                                            Room Type #@item.RoomTypeId

                                        </div>

                                    </div>

                                </div>

                            </td>


                            <!-- DESCRIPTION -->

                            <td class="px-6 py-5
                                text-sm text-gray-500
                                max-w-xs">

                                @(string.IsNullOrWhiteSpace(item.Description)
                                    ? "No description"
                                    : item.Description)

                            </td>


                            <!-- PRICE -->

                            <td class="px-6 py-5">

                                <div class="font-bold
                                    text-gray-800">

                                    @item.PricePerNight.ToString("N0")

                                </div>

                                <div class="text-xs
                                    text-gray-400">

                                    MMK / night

                                </div>

                            </td>


                            <!-- STATUS -->

                            <td class="px-6 py-5">

                                <span class="inline-flex
                                    items-center gap-2
                                    px-3 py-1.5
                                    rounded-full
                                    bg-emerald-50
                                    text-emerald-700
                                    text-xs
                                    font-semibold">

                                    <span class="w-1.5 h-1.5
                                        rounded-full
                                        bg-emerald-500">
                                    </span>

                                    Active

                                </span>

                            </td>


                            <!-- ACTIONS -->

                            <td class="px-6 py-5">

                                <div class="flex items-center
                                    justify-end gap-2">


                                    <!-- EDIT -->

                                    <a asp-controller="RoomType"
                                       asp-action="Edit"
                                       asp-route-id="@item.RoomTypeId"
                                       class="w-9 h-9
                                        rounded-lg
                                        bg-blue-50
                                        text-blue-600
                                        flex items-center
                                        justify-center
                                        hover:bg-blue-600
                                        hover:text-white
                                        transition"
                                       title="Edit">

                                        <i data-lucide="pencil"
                                           class="w-4 h-4">
                                        </i>

                                    </a>


                                    <!-- DELETE -->

                                    <form asp-controller="RoomType"
                                          asp-action="Delete"
                                          asp-route-id="@item.RoomTypeId"
                                          method="post"
                                          class="inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                onclick="return confirm('Are you sure you want to delete this room type?')"
                                                class="w-9 h-9
                                            rounded-lg
                                            bg-red-50
                                            text-red-600
                                            flex items-center
                                            justify-center
                                            hover:bg-red-600
                                            hover:text-white
                                            transition"
                                                title="Delete">

                                            <i data-lucide="trash-2"
                                               class="w-4 h-4">
                                            </i>

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>

                        count++;
                    }


                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="6"
                                class="px-6 py-16
                                text-center">


                                <div class="w-16 h-16
                                    mx-auto
                                    rounded-2xl
                                    bg-gray-100
                                    flex items-center
                                    justify-center
                                    mb-4">

                                    <i data-lucide="layers-3"
                                       class="w-7 h-7
                                        text-gray-400">
                                    </i>

                                </div>


                                <h3 class="font-bold
                                    text-gray-700">

                                    No Room Types

                                </h3>


                                <p class="text-sm
                                    text-gray-400
                                    mt-1 mb-5">

                                    Create your first room type
                                    to get started.

                                </p>


                                <a asp-controller="RoomType"
                                   asp-action="Create"
                                   class="inline-flex
                                    items-center
                                    gap-2
                                    bg-blue-600
                                    text-white
                                    px-4 py-2.5
                                    rounded-xl
                                    font-medium
                                    hover:bg-blue-700">

                                    <i data-lucide="plus"
                                       class="w-4 h-4">
                                    </i>

                                    Add Room Type

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        $("#roomTypeSearch").on("keyup", function() {

            const searchValue =
                $(this).val().toLowerCase();

            $(".room-type-row").each(function() {

                const rowText =
                    $(this).text().toLowerCase();

                if (rowText.includes(searchValue)) {

                    $(this).show();

                }
                else {

                    $(this).hide();

                }

            });

        });

    </script>

}