@model Hotelbooking.Database.Models.TblRoomType

@{
    ViewData["Title"] = "Create Room Type";
}

<div class="max-w-2xl mx-auto">

    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-800">
            Create Room Type
        </h1>
        <p class="text-gray-500">
            Add a new hotel room type
        </p>
    </div>

    <div class="bg-white shadow rounded-xl p-6">

        <form asp-controller="RoomType"
              asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-red-600 mb-4">
            </div>

            <div class="mb-4">

                <label asp-for="RoomTypeName"
                       class="block font-medium mb-2">
                    Room Type Name
                </label>

                <input asp-for="RoomTypeName"
                       class="w-full border rounded-lg px-4 py-2"
                       placeholder="Example: Deluxe Room" />

                <span asp-validation-for="RoomTypeName"
                      class="text-red-500 text-sm">
                </span>

            </div>

            <div class="mb-4">

                <label asp-for="Description"
                       class="block font-medium mb-2">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="w-full border rounded-lg px-4 py-2"
                          rows="4"
                          placeholder="Room type description"></textarea>

                <span asp-validation-for="Description"
                      class="text-red-500 text-sm">
                </span>

            </div>

            <div class="mb-6">

                <label asp-for="PricePerNight"
                       class="block font-medium mb-2">
                    Price Per Night
                </label>

                <input asp-for="PricePerNight"
                       type="number"
                       step="0.01"
                       class="w-full border rounded-lg px-4 py-2"
                       placeholder="Example: 50000" />

                <span asp-validation-for="PricePerNight"
                      class="text-red-500 text-sm">
                </span>

            </div>

            <div class="flex gap-3">

                <button type="submit"
                        class="bg-blue-600 text-white px-5 py-2 rounded-lg hover:bg-blue-700">
                    Save
                </button>

                <a asp-controller="RoomType"
                   asp-action="Index"
                   class="bg-gray-500 text-white px-5 py-2 rounded-lg hover:bg-gray-600">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}