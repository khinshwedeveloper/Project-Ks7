@model Hotelbooking.Database.Models.TblExtraBedPrice

@{
    ViewData["Title"] = "Delete Extra Bed Price";
}

<div class="mx-auto max-w-2xl space-y-6 p-6">
    <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Delete Extra Bed Price</h1>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Review this record before confirming deletion.</p>
    </div>

    <div class="rounded-xl border border-red-200 bg-white p-6 shadow-sm dark:border-red-900 dark:bg-gray-800">
        <div class="mb-5 rounded-lg bg-red-50 p-4 text-sm text-red-700 dark:bg-red-900/20 dark:text-red-300">
            Are you sure you want to delete this extra bed price record?
        </div>

        <dl class="divide-y divide-gray-200 dark:divide-gray-700">
            <div class="flex justify-between gap-4 py-4">
                <dt class="text-sm text-gray-500 dark:text-gray-400">ID</dt>
                <dd class="font-medium text-gray-900 dark:text-white">@Model.ExtraBedPriceId</dd>
            </div>
            <div class="flex justify-between gap-4 py-4">
                <dt class="text-sm text-gray-500 dark:text-gray-400">Room Type</dt>
                <dd class="font-medium text-gray-900 dark:text-white">@(Model.RoomType?.RoomTypeName ?? "Unknown")</dd>
            </div>
            <div class="flex justify-between gap-4 py-4">
                <dt class="text-sm text-gray-500 dark:text-gray-400">Price</dt>
                <dd class="font-medium text-gray-900 dark:text-white">@Model.Price.ToString("N2")</dd>
            </div>
            <div class="flex justify-between gap-4 py-4">
                <dt class="text-sm text-gray-500 dark:text-gray-400">Effective Date</dt>
                <dd class="font-medium text-gray-900 dark:text-white">@Model.EffectiveDate.ToString("yyyy-MM-dd")</dd>
            </div>
            <div class="flex justify-between gap-4 py-4">
                <dt class="text-sm text-gray-500 dark:text-gray-400">Status</dt>
                <dd class="font-medium text-gray-900 dark:text-white">@(Model.Status ? "Active" : "Inactive")</dd>
            </div>
        </dl>

        <form asp-action="Delete" method="post" class="mt-6 flex flex-wrap gap-3 border-t border-gray-200 pt-5 dark:border-gray-700">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.ExtraBedPriceId" />

            <button type="submit"
                    class="rounded-lg bg-red-600 px-5 py-2.5 text-sm font-medium text-white hover:bg-red-700">
                Confirm Delete
            </button>
            <a asp-action="Index"
               class="rounded-lg border border-gray-300 px-5 py-2.5 text-sm font-medium text-gray-700 hover:bg-gray-100 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-700">
                Cancel
            </a>
        </form>
    </div>
</div>
