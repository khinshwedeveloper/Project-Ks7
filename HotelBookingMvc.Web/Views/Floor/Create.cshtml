@model Hotelbooking.Database.Models.TblFloor

@{
    ViewData["Title"] = "Create Floor";
}

<div class="max-w-3xl mx-auto space-y-6">

    <div class="mb-6">
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">
            Create Floor
        </h1>
        <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
            Add a new hotel floor to the system.
        </p>
    </div>

    <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm p-6 sm:p-8">

        <form asp-action="Create" method="post" class="space-y-6">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="p-4 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800/60 text-rose-800 dark:text-rose-300 text-sm"></div>

            <div>
                <label asp-for="FloorName" class="block mb-2 text-sm font-semibold text-slate-700 dark:text-slate-200">
                    Floor Name <span class="text-rose-500">*</span>
                </label>
                <input asp-for="FloorName"
                       class="w-full rounded-xl border border-slate-200 dark:border-slate-600 px-4 py-3 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-white placeholder-slate-400 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-blue-500 outline-none transition"
                       placeholder="Example: Ground Floor, 1st Floor" />
                <span asp-validation-for="FloorName" class="text-sm text-rose-500 mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Description" class="block mb-2 text-sm font-semibold text-slate-700 dark:text-slate-200">
                    Description
                </label>
                <textarea asp-for="Description"
                          rows="4"
                          class="w-full rounded-xl border border-slate-200 dark:border-slate-600 px-4 py-3 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-white placeholder-slate-400 focus:bg-white dark:focus:bg-slate-900 focus:ring-2 focus:ring-blue-500 outline-none transition"
                          placeholder="Enter floor description..."></textarea>
                <span asp-validation-for="Description" class="text-sm text-rose-500 mt-1 block"></span>
            </div>

            <div class="flex items-center gap-3 pt-2">
                <button type="submit"
                        class="px-5 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold shadow-sm transition">
                    Save Floor
                </button>

                <a asp-action="Index"
                   class="px-5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 font-medium transition">
                    Cancel
                </a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
