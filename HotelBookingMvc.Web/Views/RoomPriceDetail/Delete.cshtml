@model Hotelbooking.Database.Models.TblRoomPriceDetail

@{
    ViewData["Title"] = "Delete Time Slot";
}

<div class="mx-auto max-w-xl space-y-6">
    <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-6 sm:p-8 shadow-sm">
        <h1 class="text-2xl font-bold text-rose-600 dark:text-rose-400">Delete Time Slot?</h1>
        <p class="my-4 text-sm text-slate-500 dark:text-slate-400">Are you sure you want to delete this price slot?</p>

        <dl class="space-y-3 divide-y divide-slate-100 dark:divide-slate-700/60 text-sm">
            <div class="pt-2 flex justify-between">
                <dt class="text-slate-500 dark:text-slate-400 font-medium">Pricing Setup</dt>
                <dd class="font-semibold text-slate-900 dark:text-white">@Model.RoomPrice?.PriceName</dd>
            </div>
            <div class="pt-3 flex justify-between">
                <dt class="text-slate-500 dark:text-slate-400 font-medium">Time Slot</dt>
                <dd class="font-medium text-slate-800 dark:text-slate-200">@Model.StartTime.ToString("HH:mm") – @Model.EndTime.ToString("HH:mm")</dd>
            </div>
            <div class="pt-3 flex justify-between">
                <dt class="text-slate-500 dark:text-slate-400 font-medium">Price</dt>
                <dd class="font-bold text-indigo-600 dark:text-indigo-400">@Model.Price.ToString("N2") MMK</dd>
            </div>
        </dl>

        <form asp-action="Delete" asp-route-id="@Model.RoomPriceDetailId"
              method="post" class="mt-6 flex gap-3 pt-4 border-t border-slate-100 dark:border-slate-700/60">
            @Html.AntiForgeryToken()
            <button type="submit" class="rounded-xl bg-rose-600 hover:bg-rose-700 px-5 py-3 font-semibold text-white shadow-sm transition">
                Confirm Delete
            </button>
            <a asp-action="Index" asp-route-priceId="@Model.RoomPriceId"
               class="rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700 px-5 py-3 font-medium transition">Cancel</a>
        </form>
    </div>
</div>
