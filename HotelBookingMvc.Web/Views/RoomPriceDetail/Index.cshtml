@model IEnumerable<Hotelbooking.Database.Models.TblRoomPriceDetail>

@{
    ViewData["Title"] = "Room Price Details";
    int priceId = (int)ViewBag.PriceId;
}

<div class="max-w-6xl mx-auto space-y-6">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">Room Price Details</h1>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                Pricing setup: <strong class="text-slate-800 dark:text-slate-200">@ViewBag.PriceName</strong>
                @if (ViewBag.RoomTypeName != null)
                {
                    <span> — @ViewBag.RoomTypeName</span>
                }
            </p>
        </div>
        <a asp-action="Create" asp-route-priceId="@priceId"
           class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 px-5 py-3 font-semibold text-white shadow-sm transition">
            <i data-lucide="plus" class="w-4 h-4"></i>
            Add Time Slot
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800/60 p-4 text-emerald-800 dark:text-emerald-300 text-sm">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800/60 p-4 text-rose-800 dark:text-rose-300 text-sm">@TempData["Error"]</div>
    }

    <div class="overflow-x-auto rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-sm">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 dark:bg-slate-900/60 text-xs uppercase tracking-wider text-slate-600 dark:text-slate-400 border-b border-slate-200 dark:border-slate-700">
                <tr>
                    <th class="p-4">ID</th>
                    <th class="p-4">Start Time</th>
                    <th class="p-4">End Time</th>
                    <th class="p-4">Price (MMK)</th>
                    <th class="p-4">Status</th>
                    <th class="p-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 dark:divide-slate-700">
                @foreach (var item in Model)
                {
                    <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-700/40 transition">
                        <td class="p-4 text-slate-500 dark:text-slate-400">@item.RoomPriceDetailId</td>
                        <td class="p-4 font-semibold text-slate-900 dark:text-white">@item.StartTime.ToString("HH:mm")</td>
                        <td class="p-4 font-semibold text-slate-900 dark:text-white">@item.EndTime.ToString("HH:mm")</td>
                        <td class="p-4 font-bold text-indigo-600 dark:text-indigo-400">@item.Price.ToString("N2")</td>
                        <td class="p-4">
                            @if (item.Status)
                            {
                                <span class="rounded-full bg-emerald-50 dark:bg-emerald-900/30 border border-emerald-200 dark:border-emerald-800/60 px-3 py-1 text-xs font-semibold text-emerald-700 dark:text-emerald-300">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="rounded-full bg-slate-100 dark:bg-slate-700 border border-slate-200 dark:border-slate-600 px-3 py-1 text-xs font-semibold text-slate-600 dark:text-slate-300">
                                    Inactive
                                </span>
                            }
                        </td>
                        <td class="whitespace-nowrap p-4 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <a asp-action="Edit" asp-route-id="@item.RoomPriceDetailId"
                                   class="px-3 py-1.5 rounded-lg bg-indigo-50 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-300 hover:bg-indigo-600 hover:text-white dark:hover:bg-indigo-600 dark:hover:text-white text-xs font-medium transition">
                                    Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.RoomPriceDetailId"
                                   class="px-3 py-1.5 rounded-lg bg-rose-50 dark:bg-rose-900/30 text-rose-600 dark:text-rose-300 hover:bg-rose-600 hover:text-white dark:hover:bg-rose-600 dark:hover:text-white text-xs font-medium transition">
                                    Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        @if (!Model.Any())
        {
            <p class="p-8 text-center text-slate-400 dark:text-slate-500">No time slots yet. Add your first time slot.</p>
        }
    </div>

    <div>
        <a asp-controller="RoomPrice" asp-action="Index"
           class="inline-flex items-center gap-2 font-medium text-indigo-600 dark:text-indigo-400 hover:underline">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Back to Room Price Master
        </a>
    </div>
</div>
