@model List<Hotelbooking.Database.Models.TblCustomer>

@{
    ViewData["Title"] = "Customers";
}

<div class="max-w-7xl mx-auto">

    <!-- PAGE HEADER -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-8">

        <div>

            <div class="flex items-center gap-2 text-sm text-gray-400 mb-2">

                <i data-lucide="users" class="w-4 h-4"></i>

                Customer Management

            </div>

            <h1 class="text-3xl font-extrabold text-gray-900">
                Customers
            </h1>

            <p class="text-gray-500 mt-1">
                Manage customer information and contact details.
            </p>

        </div>

        <a asp-controller="Customer"
           asp-action="Create"
           class="premium-button inline-flex items-center justify-center gap-2
            bg-blue-600 hover:bg-blue-700 text-white
            px-5 py-3 rounded-xl font-semibold
            shadow-lg shadow-blue-600/20">

            <i data-lucide="user-plus" class="w-5 h-5"></i>

            Add Customer

        </a>

    </div>





    <!-- SUMMARY CARDS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3
        gap-5 mb-8">


        <!-- TOTAL CUSTOMERS -->
        <div class="premium-card p-5">

            <div class="flex items-center justify-between">

                <div>

                    <p class="text-sm text-gray-500">
                        Total Customers
                    </p>

                    <h2 class="text-3xl font-bold text-gray-900 mt-2">
                        @Model.Count
                    </h2>

                </div>

                <div class="w-12 h-12 rounded-xl bg-blue-50
                    flex items-center justify-center">

                    <i data-lucide="users"
                       class="w-6 h-6 text-blue-600">
                    </i>

                </div>

            </div>

        </div>


        <!-- PHONE -->
        <div class="premium-card p-5">

            <div class="flex items-center justify-between">

                <div>

                    <p class="text-sm text-gray-500">
                        Phone Available
                    </p>

                    <h2 class="text-3xl font-bold text-gray-900 mt-2">

                        @Model.Count(x =>
                            !string.IsNullOrWhiteSpace(x.Phone))

                    </h2>

                </div>

                <div class="w-12 h-12 rounded-xl bg-emerald-50
                    flex items-center justify-center">

                    <i data-lucide="phone"
                       class="w-6 h-6 text-emerald-600">
                    </i>

                </div>

            </div>

        </div>


        <!-- EMAIL -->
        <div class="premium-card p-5">

            <div class="flex items-center justify-between">

                <div>

                    <p class="text-sm text-gray-500">
                        Email Available
                    </p>

                    <h2 class="text-3xl font-bold text-gray-900 mt-2">

                        @Model.Count(x =>
                            !string.IsNullOrWhiteSpace(x.Email))

                    </h2>

                </div>

                <div class="w-12 h-12 rounded-xl bg-violet-50
                    flex items-center justify-center">

                    <i data-lucide="mail"
                       class="w-6 h-6 text-violet-600">
                    </i>

                </div>

            </div>

        </div>

    </div>


    <!-- CUSTOMER TABLE -->
    <div class="premium-card overflow-hidden">


        <!-- TABLE HEADER -->
        <div class="px-6 py-5 border-b border-gray-100
            flex flex-col md:flex-row
            md:items-center md:justify-between gap-4">

            <div>

                <h2 class="font-bold text-gray-800">
                    All Customers
                </h2>

                <p class="text-sm text-gray-400 mt-1">
                    View and manage registered customers.
                </p>

            </div>


            <!-- SEARCH -->
            <div class="relative">

                <i data-lucide="search"
                   class="absolute left-3 top-1/2
                    -translate-y-1/2
                    w-4 h-4 text-gray-400">
                </i>

                <input id="customerSearch"
                       type="text"
                       placeholder="Search customer..."
                       class="w-full md:w-72
                pl-10 pr-4 py-2.5
                bg-gray-50
                border border-gray-200
                rounded-xl
                text-sm
                outline-none
                focus:ring-2
                focus:ring-blue-500
                focus:border-transparent">

            </div>

        </div>


        <!-- TABLE -->
        <div class="overflow-x-auto">

            <table class="w-full">

                <thead>

                    <tr class="bg-gray-50
                        text-xs uppercase
                        tracking-wider
                        text-gray-400">

                        <th class="px-6 py-4 text-left">
                            #
                        </th>

                        <th class="px-6 py-4 text-left">
                            Customer
                        </th>

                        <th class="px-6 py-4 text-left">
                            Phone
                        </th>

                        <th class="px-6 py-4 text-left">
                            Email
                        </th>

                        <th class="px-6 py-4 text-left">
                            NRC
                        </th>

                        <th class="px-6 py-4 text-right">
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody id="customerTable">

                    @{
                        int count = 1;
                    }


                    @foreach (var item in Model)
                    {
                        <tr class="table-row border-t border-gray-100 customer-row">


                            <!-- NUMBER -->
                            <td class="px-6 py-5
                                text-sm text-gray-400">

                                @count

                            </td>


                            <!-- CUSTOMER -->
                            <td class="px-6 py-5">

                                <div class="flex items-center gap-3">

                                    <div class="w-10 h-10
                                        rounded-xl
                                        bg-blue-50
                                        flex items-center
                                        justify-center">

                                        <i data-lucide="user"
                                           class="w-5 h-5
                                            text-blue-600">
                                        </i>

                                    </div>

                                    <div>

                                        <div class="font-semibold
                                            text-gray-800">

                                            @item.CustomerName

                                        </div>

                                        <div class="text-xs
                                            text-gray-400">

                                            Customer #@item.CustomerId

                                        </div>

                                    </div>

                                </div>

                            </td>


                            <!-- PHONE -->
                            <td class="px-6 py-5">

                                @if (!string.IsNullOrWhiteSpace(item.Phone))
                                {
                                    <div class="flex items-center gap-2
                                        text-sm text-gray-600">

                                        <i data-lucide="phone"
                                           class="w-4 h-4
                                            text-gray-400">
                                        </i>

                                        @item.Phone

                                    </div>
                                }
                                else
                                {
                                    <span class="text-sm text-gray-400">
                                        Not provided
                                    </span>
                                }

                            </td>


                            <!-- EMAIL -->
                            <td class="px-6 py-5">

                                @if (!string.IsNullOrWhiteSpace(item.Email))
                                {
                                    <div class="flex items-center gap-2
                                        text-sm text-gray-600">

                                        <i data-lucide="mail"
                                           class="w-4 h-4
                                            text-gray-400">
                                        </i>

                                        @item.Email

                                    </div>
                                }
                                else
                                {
                                    <span class="text-sm text-gray-400">
                                        Not provided
                                    </span>
                                }

                            </td>


                            <!-- NRC -->
                            <td class="px-6 py-5">

                                @if (!string.IsNullOrWhiteSpace(item.Nrc))
                                {
                                    <span class="inline-flex
                                        px-3 py-1.5
                                        rounded-lg
                                        bg-gray-100
                                        text-gray-600
                                        text-xs
                                        font-medium">

                                        @item.Nrc

                                    </span>
                                }
                                else
                                {
                                    <span class="text-sm text-gray-400">
                                        Not provided
                                    </span>
                                }

                            </td>


                            <!-- ACTIONS -->
                            <td class="px-6 py-5">

                                <div class="flex items-center
                                    justify-end gap-2">


                                    <!-- EDIT -->
                                    <a asp-controller="Customer"
                                       asp-action="Edit"
                                       asp-route-id="@item.CustomerId"
                                       class="w-9 h-9 rounded-lg
                                        bg-blue-50 text-blue-600
                                        flex items-center
                                        justify-center
                                        hover:bg-blue-600
                                        hover:text-white
                                        transition"
                                       title="Edit Customer">

                                        <i data-lucide="pencil"
                                           class="w-4 h-4">
                                        </i>

                                    </a>


                                    <!-- DELETE -->
                                    <form asp-controller="Customer"
                                          asp-action="Delete"
                                          asp-route-id="@item.CustomerId"
                                          method="post"
                                          class="inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                onclick="return confirm('Are you sure you want to delete this customer?')"
                                                class="w-9 h-9 rounded-lg
                                            bg-red-50 text-red-600
                                            flex items-center
                                            justify-center
                                            hover:bg-red-600
                                            hover:text-white
                                            transition"
                                                title="Delete Customer">

                                            <i data-lucide="trash-2"
                                               class="w-4 h-4">
                                            </i>

                                        </button>

                                    </form>

                                </div>

                            </td>

                        </tr>

                        count++;
                    }


                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="6"
                                class="px-6 py-16 text-center">


                                <div class="w-16 h-16 mx-auto
                                    rounded-2xl
                                    bg-gray-100
                                    flex items-center
                                    justify-center
                                    mb-4">

                                    <i data-lucide="users"
                                       class="w-7 h-7
                                        text-gray-400">
                                    </i>

                                </div>


                                <h3 class="font-bold text-gray-700">
                                    No Customers
                                </h3>


                                <p class="text-sm text-gray-400
                                    mt-1 mb-5">

                                    Add your first customer
                                    to get started.

                                </p>


                                <a asp-controller="Customer"
                                   asp-action="Create"
                                   class="inline-flex items-center
                                    gap-2 bg-blue-600
                                    text-white px-4 py-2.5
                                    rounded-xl font-medium
                                    hover:bg-blue-700">

                                    <i data-lucide="user-plus"
                                       class="w-4 h-4">
                                    </i>

                                    Add Customer

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        $("#customerSearch").on("keyup", function() {

            const searchValue =
                $(this).val().toLowerCase();

            $(".customer-row").each(function() {

                const rowText =
                    $(this).text().toLowerCase();

                if (rowText.includes(searchValue)) {

                    $(this).show();

                }
                else {

                    $(this).hide();

                }

            });

        });

    </script>

}