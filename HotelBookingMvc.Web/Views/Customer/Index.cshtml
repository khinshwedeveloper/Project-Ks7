@model List<Hotelbooking.Database.Models.TblCustomer>

@{
    ViewData["Title"] = "Customers";
}

<div class="max-w-7xl mx-auto space-y-8">

    <!-- PAGE HEADER -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-sm text-slate-400 dark:text-slate-400 mb-2">
                <i data-lucide="users" class="w-4 h-4 text-blue-500"></i>
                <span>Customer Management</span>
            </div>

            <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
                Customers
            </h1>

            <p class="text-slate-500 dark:text-slate-400 mt-1">
                Manage customer information, contacts, and identification records.
            </p>
        </div>

        <a asp-controller="Customer"
           asp-action="Create"
           class="inline-flex items-center justify-center gap-2 bg-blue-600 hover:bg-blue-700 text-white px-5 py-3 rounded-xl font-semibold shadow-lg shadow-blue-600/20 transition">
            <i data-lucide="user-plus" class="w-5 h-5"></i>
            Add Customer
        </a>
    </div>

    <!-- SUMMARY CARDS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <!-- TOTAL CUSTOMERS -->
        <div class="premium-card p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Total Customers</p>
                    <h2 class="text-3xl font-bold text-slate-900 dark:text-white mt-2">@Model.Count</h2>
                </div>
                <div class="w-12 h-12 rounded-xl bg-blue-50 dark:bg-blue-950/60 flex items-center justify-center">
                    <i data-lucide="users" class="w-6 h-6 text-blue-600 dark:text-blue-400"></i>
                </div>
            </div>
        </div>

        <!-- PHONE AVAILABLE -->
        <div class="premium-card p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Phone Available</p>
                    <h2 class="text-3xl font-bold text-slate-900 dark:text-white mt-2">@Model.Count(x => !string.IsNullOrWhiteSpace(x.Phone))</h2>
                </div>
                <div class="w-12 h-12 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 flex items-center justify-center">
                    <i data-lucide="phone" class="w-6 h-6 text-emerald-600 dark:text-emerald-400"></i>
                </div>
            </div>
        </div>

        <!-- EMAIL AVAILABLE -->
        <div class="premium-card p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium text-slate-500 dark:text-slate-400">Email Available</p>
                    <h2 class="text-3xl font-bold text-slate-900 dark:text-white mt-2">@Model.Count(x => !string.IsNullOrWhiteSpace(x.Email))</h2>
                </div>
                <div class="w-12 h-12 rounded-xl bg-violet-50 dark:bg-violet-950/60 flex items-center justify-center">
                    <i data-lucide="mail" class="w-6 h-6 text-violet-600 dark:text-violet-400"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- CUSTOMER TABLE CARD -->
    <div class="premium-card overflow-hidden">
        <!-- TABLE HEADER -->
        <div class="px-6 py-5 border-b border-slate-100 dark:border-slate-700/60 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
            <div>
                <h2 class="font-bold text-slate-900 dark:text-white">All Customers</h2>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">View and search registered guests.</p>
            </div>

            <!-- SEARCH -->
            <div class="relative">
                <i data-lucide="search" class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400"></i>
                <input id="customerSearch"
                       type="text"
                       placeholder="Search customer..."
                       class="w-full md:w-72 pl-10 pr-4 py-2.5 bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl text-sm text-slate-800 dark:text-white placeholder-slate-400 outline-none focus:ring-2 focus:ring-blue-500 transition" />
            </div>
        </div>

        <!-- TABLE -->
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead>
                    <tr class="bg-slate-50 dark:bg-slate-900/60 text-xs uppercase tracking-wider text-slate-500 dark:text-slate-400 border-b border-slate-100 dark:border-slate-700/60">
                        <th class="px-6 py-4 text-left">#</th>
                        <th class="px-6 py-4 text-left">Code</th>
                        <th class="px-6 py-4 text-left">Customer</th>
                        <th class="px-6 py-4 text-left">Phone</th>
                        <th class="px-6 py-4 text-left">Email</th>
                        <th class="px-6 py-4 text-left">NRC</th>
                        <th class="px-6 py-4 text-right">Actions</th>
                    </tr>
                </thead>

                <tbody id="customerTable" class="divide-y divide-slate-100 dark:divide-slate-700/60">
                    @{
                        int count = 1;
                    }

                    @foreach (var item in Model)
                    {
                        <tr class="table-row customer-row hover:bg-slate-50/80 dark:hover:bg-slate-700/40 transition">
                            <!-- NUMBER -->
                            <td class="px-6 py-5 text-sm text-slate-400 dark:text-slate-500">
                                @count
                            </td>

                            <!-- CODE -->
                            <td class="px-6 py-5">
                                <span class="px-2.5 py-1 rounded-md bg-blue-50 dark:bg-blue-900/30 text-blue-700 dark:text-blue-300 border border-blue-200 dark:border-blue-800/50 text-xs font-semibold">
                                    @item.CustomerCode
                                </span>
                            </td>

                            <!-- CUSTOMER -->
                            <td class="px-6 py-5">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/60 flex items-center justify-center">
                                        <i data-lucide="user" class="w-5 h-5 text-blue-600 dark:text-blue-400"></i>
                                    </div>
                                    <div>
                                        <div class="font-semibold text-slate-900 dark:text-white">
                                            @item.Name
                                        </div>
                                        <div class="text-xs text-slate-400 dark:text-slate-500">
                                            ID #@item.CustomerId
                                        </div>
                                    </div>
                                </div>
                            </td>

                            <!-- PHONE -->
                            <td class="px-6 py-5">
                                @if (!string.IsNullOrWhiteSpace(item.Phone))
                                {
                                    <div class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
                                        <i data-lucide="phone" class="w-4 h-4 text-slate-400"></i>
                                        @item.Phone
                                    </div>
                                }
                                else
                                {
                                    <span class="text-sm text-slate-400 dark:text-slate-500">Not provided</span>
                                }
                            </td>

                            <!-- EMAIL -->
                            <td class="px-6 py-5">
                                @if (!string.IsNullOrWhiteSpace(item.Email))
                                {
                                    <div class="flex items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
                                        <i data-lucide="mail" class="w-4 h-4 text-slate-400"></i>
                                        @item.Email
                                    </div>
                                }
                                else
                                {
                                    <span class="text-sm text-slate-400 dark:text-slate-500">Not provided</span>
                                }
                            </td>

                            <!-- NRC -->
                            <td class="px-6 py-5">
                                @if (!string.IsNullOrWhiteSpace(item.Nrc))
                                {
                                    <span class="inline-flex px-3 py-1.5 rounded-lg bg-slate-100 dark:bg-slate-700 text-slate-700 dark:text-slate-300 text-xs font-medium">
                                        @item.Nrc
                                    </span>
                                }
                                else
                                {
                                    <span class="text-sm text-slate-400 dark:text-slate-500">Not provided</span>
                                }
                            </td>

                            <!-- ACTIONS -->
                            <td class="px-6 py-5">
                                <div class="flex items-center justify-end gap-2">
                                    <a asp-controller="Customer"
                                       asp-action="Edit"
                                       asp-route-id="@item.CustomerId"
                                       class="w-9 h-9 rounded-lg bg-blue-50 dark:bg-blue-900/30 text-blue-600 dark:text-blue-300 flex items-center justify-center hover:bg-blue-600 hover:text-white dark:hover:bg-blue-600 dark:hover:text-white transition"
                                       title="Edit Customer">
                                        <i data-lucide="pencil" class="w-4 h-4"></i>
                                    </a>

                                    <form asp-controller="Customer"
                                          asp-action="Delete"
                                          asp-route-id="@item.CustomerId"
                                          method="post"
                                          class="inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                onclick="return confirm('Are you sure you want to delete this customer?')"
                                                class="w-9 h-9 rounded-lg bg-rose-50 dark:bg-rose-900/30 text-rose-600 dark:text-rose-300 flex items-center justify-center hover:bg-rose-600 hover:text-white dark:hover:bg-rose-600 dark:hover:text-white transition"
                                                title="Delete Customer">
                                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>

                        count++;
                    }

                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="px-6 py-16 text-center">
                                <div class="w-16 h-16 mx-auto rounded-2xl bg-slate-100 dark:bg-slate-700 flex items-center justify-center mb-4">
                                    <i data-lucide="users" class="w-7 h-7 text-slate-400"></i>
                                </div>
                                <h3 class="font-bold text-slate-800 dark:text-white">No Customers</h3>
                                <p class="text-sm text-slate-500 dark:text-slate-400 mt-1 mb-5">Add your first customer to get started.</p>
                                <a asp-controller="Customer" asp-action="Create" class="inline-flex items-center gap-2 bg-blue-600 text-white px-4 py-2.5 rounded-xl font-medium hover:bg-blue-700">
                                    <i data-lucide="user-plus" class="w-4 h-4"></i> Add Customer
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $("#customerSearch").on("keyup", function() {
            const searchValue = $(this).val().toLowerCase();
            $(".customer-row").each(function() {
                const rowText = $(this).text().toLowerCase();
                if (rowText.includes(searchValue)) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        });
    </script>
}