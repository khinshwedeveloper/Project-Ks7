@model Hotelbooking.Database.Models.TblCustomer

@{
    ViewData["Title"] = "Create Customer";
}

<div class="max-w-4xl mx-auto space-y-6">

    <!-- PAGE HEADER -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <div class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 mb-2">
                <i data-lucide="users" class="w-4 h-4 text-blue-500"></i>
                <a asp-action="Index" class="hover:text-blue-500 transition">Customers</a>
                <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
                <span class="text-slate-700 dark:text-slate-200 font-medium">Add Customer</span>
            </div>

            <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
                Add Customer
            </h1>

            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                Register a new guest or corporate client for reservations
            </p>
        </div>

        <a asp-action="Index"
           class="glass-btn inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-semibold transition">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            Back to List
        </a>
    </div>

    <!-- GLASS FORM CARD -->
    <div class="glass-card p-6 sm:p-8">

        <form asp-action="Create" method="post" class="space-y-6">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 text-sm">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                <!-- Customer Name -->
                <div>
                    <label asp-for="CustomerName"
                           class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200">
                        Customer Name <span class="text-rose-500">*</span>
                    </label>

                    <div class="relative">
                        <input asp-for="CustomerName"
                               class="w-full px-4 py-3 outline-none transition"
                               placeholder="e.g. John Doe" />
                    </div>

                    <span asp-validation-for="CustomerName" class="text-xs text-rose-500 mt-1 block font-medium"></span>
                </div>

                <!-- Phone -->
                <div>
                    <label asp-for="Phone"
                           class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200">
                        Phone Number <span class="text-rose-500">*</span>
                    </label>

                    <div class="relative">
                        <input asp-for="Phone"
                               class="w-full px-4 py-3 outline-none transition"
                               placeholder="e.g. +1 234 567 890" />
                    </div>

                    <span asp-validation-for="Phone" class="text-xs text-rose-500 mt-1 block font-medium"></span>
                </div>

                <!-- Email -->
                <div>
                    <label asp-for="Email"
                           class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200">
                        Email Address
                    </label>

                    <div class="relative">
                        <input asp-for="Email"
                               type="email"
                               class="w-full px-4 py-3 outline-none transition"
                               placeholder="e.g. customer@example.com" />
                    </div>

                    <span asp-validation-for="Email" class="text-xs text-rose-500 mt-1 block font-medium"></span>
                </div>

                <!-- NRC / ID -->
                <div>
                    <label asp-for="Nrc"
                           class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200">
                        NRC / Passport / ID Number
                    </label>

                    <div class="relative">
                        <input asp-for="Nrc"
                               class="w-full px-4 py-3 outline-none transition"
                               placeholder="e.g. 12/LAMANA(N)123456" />
                    </div>

                    <span asp-validation-for="Nrc" class="text-xs text-rose-500 mt-1 block font-medium"></span>
                </div>

            </div>

            <!-- Address -->
            <div>
                <label asp-for="Address"
                       class="mb-2 block text-sm font-semibold text-slate-700 dark:text-slate-200">
                    Address
                </label>

                <textarea asp-for="Address"
                          rows="3"
                          class="w-full px-4 py-3 outline-none transition"
                          placeholder="Enter customer's physical or billing address..."></textarea>

                <span asp-validation-for="Address" class="text-xs text-rose-500 mt-1 block font-medium"></span>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-4 pt-4 border-t border-slate-200/60 dark:border-white/10">
                <button type="submit"
                        class="premium-button inline-flex items-center gap-2 px-6 py-3 font-semibold text-white cursor-pointer">
                    <i data-lucide="check" class="w-4 h-4"></i>
                    Save Customer
                </button>

                <a asp-action="Index"
                   class="glass-btn inline-flex items-center gap-2 px-6 py-3 font-semibold text-slate-700 dark:text-slate-300 rounded-xl cursor-pointer">
                    Cancel
                </a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}