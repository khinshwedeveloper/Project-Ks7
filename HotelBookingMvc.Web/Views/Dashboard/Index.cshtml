@model HotelBookingMvc.Web.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var occupancy = Math.Round(Model.OccupancyRate, 1);

    var totalRooms = Model.TotalRooms;
    var availableRooms = Model.AvailableRooms;
    var reservedRooms = Model.ReservedRooms;
    var occupiedRooms = Model.OccupiedRooms;
    var maintenanceRooms = Model.MaintenanceRooms;

    var maxRoomStatus = Math.Max(
        Math.Max(availableRooms, reservedRooms),
        Math.Max(occupiedRooms, maintenanceRooms));

    if (maxRoomStatus == 0)
    {
        maxRoomStatus = 1;
    }
}

<div class="min-h-screen bg-transparent transition-colors duration-300 space-y-6">

    <!-- PAGE HEADER -->
    <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
            <div class="flex items-center gap-2 text-sm text-slate-500 dark:text-slate-400 mb-2">
                <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                <span>Overview</span>
                <i data-lucide="chevron-right" class="w-3 h-3"></i>
                <span class="text-slate-700 dark:text-slate-200">Dashboard</span>
            </div>

            <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 dark:text-white">
                Hotel Dashboard
            </h1>

            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
                Monitor hotel performance, guest flow, room occupancy, and revenue.
            </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <div class="flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 shadow-sm dark:border-slate-800 dark:bg-[#111827]">
                <i data-lucide="calendar-days" class="w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
                <span class="text-sm font-medium text-slate-700 dark:text-slate-200">
                    @(string.IsNullOrEmpty(Model.DateRangeDescription) ? DateTime.Now.ToString("dd MMM yyyy") : Model.DateRangeDescription)
                </span>
            </div>

            <a asp-controller="Booking"
               asp-action="Create"
               class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-700 transition">
                <i data-lucide="plus" class="w-4 h-4"></i>
                New Booking
            </a>
        </div>
    </div>

    <!-- DATE FILTER SECTION -->
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-[#111827]">
        <div class="mb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-4 dark:border-slate-800">
            <div class="flex items-center gap-3">
                <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-50 dark:bg-indigo-500/10">
                    <i data-lucide="filter" class="h-5 w-5 text-indigo-600 dark:text-indigo-400"></i>
                </div>
                <div>
                    <h2 class="font-semibold text-slate-900 dark:text-white">
                        Date Range Flow Filter
                    </h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400">
                        Filter revenue, check-ins, check-outs, and booking operations by custom date range.
                    </p>
                </div>
            </div>

            <!-- Quick Preset Badges -->
            <div class="flex flex-wrap items-center gap-1.5">
                <button type="button" onclick="setPreset('today')" class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-600 hover:bg-indigo-50 hover:text-indigo-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">
                    Today
                </button>
                <button type="button" onclick="setPreset('yesterday')" class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-600 hover:bg-indigo-50 hover:text-indigo-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">
                    Yesterday
                </button>
                <button type="button" onclick="setPreset('thisWeek')" class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-600 hover:bg-indigo-50 hover:text-indigo-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">
                    This Week
                </button>
                <button type="button" onclick="setPreset('thisMonth')" class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-600 hover:bg-indigo-50 hover:text-indigo-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">
                    This Month
                </button>
                <button type="button" onclick="setPreset('last30')" class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-xs font-medium text-slate-600 hover:bg-indigo-50 hover:text-indigo-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">
                    Last 30 Days
                </button>
            </div>
        </div>

        <form id="filterForm" asp-controller="Dashboard" asp-action="Index" method="get" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <!-- From Date -->
            <div>
                <label for="fromDate" class="mb-1.5 block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider">
                    From Date
                </label>
                <div class="relative">
                    <input type="date"
                           id="fromDate"
                           name="fromDate"
                           value="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                           class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-800 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
            </div>

            <!-- To Date -->
            <div>
                <label for="toDate" class="mb-1.5 block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider">
                    To Date
                </label>
                <div class="relative">
                    <input type="date"
                           id="toDate"
                           name="toDate"
                           value="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                           class="w-full rounded-xl border border-slate-200 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-800 outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-white" />
                </div>
            </div>

            <!-- Apply Button -->
            <div class="flex items-end">
                <button type="submit"
                        class="flex w-full items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700">
                    <i data-lucide="search" class="h-4 w-4"></i>
                    Apply Filter
                </button>
            </div>

            <!-- Reset Button -->
            <div class="flex items-end">
                <a asp-controller="Dashboard"
                   asp-action="Index"
                   class="flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700">
                    <i data-lucide="rotate-ccw" class="h-4 w-4"></i>
                    Reset to Today
                </a>
            </div>
        </form>
    </div>

    <!-- KPI CARDS (FILTERED DATA) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">

        <!-- TOTAL REVENUE -->
        <div class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg dark:border-slate-800 dark:bg-[#111827]">
            <div class="flex items-start justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                        Period Revenue
                    </p>
                    <h2 class="mt-2 text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">
                        @Model.TotalRevenue.ToString("#,##0.00")
                    </h2>
                </div>
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-50 dark:bg-amber-500/10">
                    <i data-lucide="banknote" class="w-5 h-5 text-amber-600 dark:text-amber-400"></i>
                </div>
            </div>
            <div class="mt-4 flex items-center justify-between text-xs text-amber-600 dark:text-amber-400">
                <span class="flex items-center gap-1.5">
                    <i data-lucide="wallet" class="w-3.5 h-3.5"></i>
                    Payments collected
                </span>
                <span class="font-medium text-slate-400">
                    Range total
                </span>
            </div>
        </div>

        <!-- TOTAL BOOKINGS -->
        <div class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg dark:border-slate-800 dark:bg-[#111827]">
            <div class="flex items-start justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                        Total Bookings
                    </p>
                    <h2 class="mt-2 text-3xl font-bold text-slate-900 dark:text-white">
                        @Model.TotalBookings
                    </h2>
                </div>
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-50 dark:bg-indigo-500/10">
                    <i data-lucide="calendar-check" class="w-5 h-5 text-indigo-600 dark:text-indigo-400"></i>
                </div>
            </div>
            <div class="mt-4 flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400">
                <span class="text-emerald-600 dark:text-emerald-400 font-medium">@Model.ConfirmedBookings Confirmed</span>
                <span>•</span>
                <span class="text-blue-600 dark:text-blue-400 font-medium">@Model.CheckedInBookings In</span>
            </div>
        </div>

        <!-- CHECK-INS IN PERIOD -->
        <div class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg dark:border-slate-800 dark:bg-[#111827]">
            <div class="flex items-start justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                        Period Check-Ins
                    </p>
                    <h2 class="mt-2 text-3xl font-bold text-slate-900 dark:text-white">
                        @Model.TodayCheckIns
                    </h2>
                </div>
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-50 dark:bg-emerald-500/10">
                    <i data-lucide="log-in" class="w-5 h-5 text-emerald-600 dark:text-emerald-400"></i>
                </div>
            </div>
            <div class="mt-4 flex items-center gap-2 text-xs text-emerald-600 dark:text-emerald-400">
                <i data-lucide="user-check" class="w-3.5 h-3.5"></i>
                Arrivals in date range
            </div>
        </div>

        <!-- CHECK-OUTS IN PERIOD -->
        <div class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg dark:border-slate-800 dark:bg-[#111827]">
            <div class="flex items-start justify-between">
                <div>
                    <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">
                        Period Check-Outs
                    </p>
                    <h2 class="mt-2 text-3xl font-bold text-slate-900 dark:text-white">
                        @Model.TodayCheckOuts
                    </h2>
                </div>
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-purple-50 dark:bg-purple-500/10">
                    <i data-lucide="log-out" class="w-5 h-5 text-purple-600 dark:text-purple-400"></i>
                </div>
            </div>
            <div class="mt-4 flex items-center gap-2 text-xs text-purple-600 dark:text-purple-400">
                <i data-lucide="user-minus" class="w-3.5 h-3.5"></i>
                Departures in date range
            </div>
        </div>

    </div>

    <!-- SECOND ROW: OCCUPANCY & ROOM STATUS & TODAY ACTIVITY -->
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-5">

        <!-- OCCUPANCY CARD -->
        <div class="xl:col-span-2 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-[#111827]">
            <div class="flex items-center justify-between mb-6">
                <div>
                    <h3 class="text-lg font-bold text-slate-900 dark:text-white">
                        Room Occupancy & Utilization
                    </h3>
                    <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
                        Current room inventory condition and live status breakdown
                    </p>
                </div>
                <div class="flex items-center gap-2 rounded-lg bg-slate-100 px-3 py-1.5 dark:bg-slate-800">
                    <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                    <span class="text-xs font-semibold text-slate-600 dark:text-slate-300">Live Status</span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
                <!-- DONUT -->
                <div class="flex justify-center">
                    <div class="relative h-48 w-48">
                        <div class="absolute inset-0 rounded-full bg-slate-100 dark:bg-slate-800"
                             style="background: conic-gradient(rgb(99 102 241) @(occupancy)%, rgb(226 232 240) @(occupancy)% 100%);">
                        </div>
                        <div class="absolute inset-[18px] rounded-full bg-white dark:bg-[#111827] flex flex-col items-center justify-center">
                            <span class="text-4xl font-bold text-slate-900 dark:text-white">
                                @occupancy%
                            </span>
                            <span class="text-xs font-medium text-slate-500 dark:text-slate-400 mt-1">
                                Occupancy Rate
                            </span>
                            <span class="text-[11px] text-indigo-600 dark:text-indigo-400 mt-0.5 font-semibold">
                                @Model.OccupiedRooms of @Model.TotalRooms Rooms
                            </span>
                        </div>
                    </div>
                </div>

                <!-- ROOM STATUS BARS -->
                <div class="space-y-4">
                    <!-- Available -->
                    <div>
                        <div class="flex justify-between mb-1.5 text-sm">
                            <span class="flex items-center gap-2 font-medium text-slate-700 dark:text-slate-300">
                                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                                Available
                            </span>
                            <span class="font-bold text-slate-900 dark:text-white">@availableRooms</span>
                        </div>
                        <div class="h-2 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                            <div class="h-full rounded-full bg-emerald-500" style="width:@((double)availableRooms / maxRoomStatus * 100)%"></div>
                        </div>
                    </div>

                    <!-- Reserved -->
                    <div>
                        <div class="flex justify-between mb-1.5 text-sm">
                            <span class="flex items-center gap-2 font-medium text-slate-700 dark:text-slate-300">
                                <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                                Reserved
                            </span>
                            <span class="font-bold text-slate-900 dark:text-white">@reservedRooms</span>
                        </div>
                        <div class="h-2 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                            <div class="h-full rounded-full bg-amber-500" style="width:@((double)reservedRooms / maxRoomStatus * 100)%"></div>
                        </div>
                    </div>

                    <!-- Occupied -->
                    <div>
                        <div class="flex justify-between mb-1.5 text-sm">
                            <span class="flex items-center gap-2 font-medium text-slate-700 dark:text-slate-300">
                                <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span>
                                Occupied
                            </span>
                            <span class="font-bold text-slate-900 dark:text-white">@occupiedRooms</span>
                        </div>
                        <div class="h-2 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                            <div class="h-full rounded-full bg-indigo-500" style="width:@((double)occupiedRooms / maxRoomStatus * 100)%"></div>
                        </div>
                    </div>

                    <!-- Maintenance -->
                    <div>
                        <div class="flex justify-between mb-1.5 text-sm">
                            <span class="flex items-center gap-2 font-medium text-slate-700 dark:text-slate-300">
                                <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
                                Maintenance
                            </span>
                            <span class="font-bold text-slate-900 dark:text-white">@maintenanceRooms</span>
                        </div>
                        <div class="h-2 rounded-full bg-slate-100 dark:bg-slate-800 overflow-hidden">
                            <div class="h-full rounded-full bg-rose-500" style="width:@((double)maintenanceRooms / maxRoomStatus * 100)%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- QUICK ACTIONS & FLOW -->
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-[#111827] flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-5">
                    <div>
                        <h3 class="text-lg font-bold text-slate-900 dark:text-white">Quick Operations</h3>
                        <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">Hotel front desk actions</p>
                    </div>
                    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-50 dark:bg-indigo-500/10">
                        <i data-lucide="zap" class="w-4 h-4 text-indigo-600 dark:text-indigo-400"></i>
                    </div>
                </div>

                <div class="space-y-3">
                    <a asp-controller="Booking" asp-action="Create"
                       class="flex items-center gap-3 rounded-xl border border-slate-200 p-3 hover:border-indigo-300 hover:bg-indigo-50/50 dark:border-slate-800 dark:hover:border-indigo-500/40 dark:hover:bg-indigo-500/5 transition">
                        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-indigo-50 dark:bg-indigo-500/10">
                            <i data-lucide="calendar-plus" class="w-5 h-5 text-indigo-600 dark:text-indigo-400"></i>
                        </span>
                        <div>
                            <p class="text-sm font-semibold text-slate-800 dark:text-white">New Booking</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Create reservation</p>
                        </div>
                        <i data-lucide="chevron-right" class="ml-auto w-4 h-4 text-slate-400"></i>
                    </a>

                    <a asp-controller="CheckIn" asp-action="Index"
                       class="flex items-center gap-3 rounded-xl border border-slate-200 p-3 hover:border-emerald-300 hover:bg-emerald-50/50 dark:border-slate-800 dark:hover:border-emerald-500/40 dark:hover:bg-emerald-500/5 transition">
                        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-emerald-50 dark:bg-emerald-500/10">
                            <i data-lucide="log-in" class="w-5 h-5 text-emerald-600 dark:text-emerald-400"></i>
                        </span>
                        <div>
                            <p class="text-sm font-semibold text-slate-800 dark:text-white">Check-in Management</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Process arrivals</p>
                        </div>
                        <i data-lucide="chevron-right" class="ml-auto w-4 h-4 text-slate-400"></i>
                    </a>

                    <a asp-controller="CheckOut" asp-action="Index"
                       class="flex items-center gap-3 rounded-xl border border-slate-200 p-3 hover:border-purple-300 hover:bg-purple-50/50 dark:border-slate-800 dark:hover:border-purple-500/40 dark:hover:bg-purple-500/5 transition">
                        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-purple-50 dark:bg-purple-500/10">
                            <i data-lucide="log-out" class="w-5 h-5 text-purple-600 dark:text-purple-400"></i>
                        </span>
                        <div>
                            <p class="text-sm font-semibold text-slate-800 dark:text-white">Check-out & Billing</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Settle accounts & departures</p>
                        </div>
                        <i data-lucide="chevron-right" class="ml-auto w-4 h-4 text-slate-400"></i>
                    </a>

                    <a asp-controller="Report" asp-action="Index"
                       class="flex items-center gap-3 rounded-xl border border-slate-200 p-3 hover:border-violet-300 hover:bg-violet-50/50 dark:border-slate-800 dark:hover:border-violet-500/40 dark:hover:bg-violet-500/5 transition">
                        <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-violet-50 dark:bg-violet-500/10">
                            <i data-lucide="bar-chart-3" class="w-5 h-5 text-violet-600 dark:text-violet-400"></i>
                        </span>
                        <div>
                            <p class="text-sm font-semibold text-slate-800 dark:text-white">Detailed Reports</p>
                            <p class="text-xs text-slate-500 dark:text-slate-400">Export & analyze records</p>
                        </div>
                        <i data-lucide="chevron-right" class="ml-auto w-4 h-4 text-slate-400"></i>
                    </a>
                </div>
            </div>
        </div>

    </div>

    <!-- RECENT BOOKINGS & PERIOD ACTIVITY FLOW -->
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-[#111827]">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between p-6 border-b border-slate-100 dark:border-slate-800 gap-4">
            <div>
                <h3 class="text-lg font-bold text-slate-900 dark:text-white">
                    Bookings & Activity Flow
                </h3>
                <p class="text-sm text-slate-500 dark:text-slate-400 mt-0.5">
                    Showing bookings within selected range: <span class="font-medium text-indigo-600 dark:text-indigo-400">@Model.DateRangeDescription</span>
                </p>
            </div>

            <div class="flex items-center gap-2">
                <a asp-controller="Report"
                   asp-action="Index"
                   asp-route-fromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                   asp-route-toDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                   class="inline-flex items-center gap-1.5 rounded-xl border border-slate-200 bg-white px-3.5 py-2 text-xs font-semibold text-slate-700 shadow-sm hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700 transition">
                    <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
                    View Full Report
                </a>
            </div>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-slate-600 dark:text-slate-300">
                <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500 dark:bg-slate-800/60 dark:text-slate-400 border-b border-slate-100 dark:border-slate-800">
                    <tr>
                        <th class="px-6 py-4 font-semibold">Booking No</th>
                        <th class="px-6 py-4 font-semibold">Guest</th>
                        <th class="px-6 py-4 font-semibold">Room</th>
                        <th class="px-6 py-4 font-semibold">Dates</th>
                        <th class="px-6 py-4 font-semibold">Status</th>
                        <th class="px-6 py-4 font-semibold text-right">Total Amount</th>
                        <th class="px-6 py-4 font-semibold text-right">Paid</th>
                        <th class="px-6 py-4 font-semibold text-center">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @if (Model.RecentBookings != null && Model.RecentBookings.Any())
                    {
                        foreach (var b in Model.RecentBookings)
                        {
                            <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition">
                                <td class="px-6 py-4 font-semibold text-slate-900 dark:text-white">
                                    <span class="inline-flex items-center gap-1.5">
                                        <i data-lucide="receipt" class="w-4 h-4 text-slate-400"></i>
                                        @b.BookingNo
                                    </span>
                                </td>
                                <td class="px-6 py-4">
                                    <div class="font-medium text-slate-900 dark:text-white">@b.CustomerName</div>
                                    <div class="text-xs text-slate-400">@b.CustomerPhone</div>
                                </td>
                                <td class="px-6 py-4">
                                    <span class="inline-flex items-center gap-1 rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                                        Room @b.RoomNumber
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-xs">
                                    <div class="text-slate-800 dark:text-slate-200">In: @b.CheckInDate.ToString("dd MMM yyyy")</div>
                                    <div class="text-slate-400">Out: @b.CheckOutDate.ToString("dd MMM yyyy")</div>
                                </td>
                                <td class="px-6 py-4">
                                    @if (b.Status == "Confirmed")
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700 dark:bg-blue-500/10 dark:text-blue-400">
                                            <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
                                            Confirmed
                                        </span>
                                    }
                                    else if (b.Status == "CheckedIn")
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-2.5 py-1 text-xs font-semibold text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-400">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                            Checked In
                                        </span>
                                    }
                                    else if (b.Status == "CheckedOut")
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-purple-50 px-2.5 py-1 text-xs font-semibold text-purple-700 dark:bg-purple-500/10 dark:text-purple-400">
                                            <span class="w-1.5 h-1.5 rounded-full bg-purple-500"></span>
                                            Checked Out
                                        </span>
                                    }
                                    else if (b.Status == "Cancelled")
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-rose-50 px-2.5 py-1 text-xs font-semibold text-rose-700 dark:bg-rose-500/10 dark:text-rose-400">
                                            <span class="w-1.5 h-1.5 rounded-full bg-rose-500"></span>
                                            Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700 dark:bg-slate-800 dark:text-slate-300">
                                            @b.Status
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right font-semibold text-slate-900 dark:text-white">
                                    @b.TotalAmount.ToString("#,##0.00")
                                </td>
                                <td class="px-6 py-4 text-right">
                                    <div class="font-medium text-emerald-600 dark:text-emerald-400">@b.PaidAmount.ToString("#,##0.00")</div>
                                    @if (b.BalanceAmount > 0)
                                    {
                                        <div class="text-xs text-amber-500">Bal: @b.BalanceAmount.ToString("#,##0.00")</div>
                                    }
                                </td>
                                <td class="px-6 py-4 text-center">
                                    <a asp-controller="Booking"
                                       asp-action="Details"
                                       asp-route-id="@b.BookingId"
                                       class="inline-flex items-center justify-center h-8 w-8 rounded-lg bg-slate-100 text-slate-600 hover:bg-indigo-50 hover:text-indigo-600 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-indigo-500/20 dark:hover:text-indigo-400 transition"
                                       title="View Details">
                                        <i data-lucide="eye" class="w-4 h-4"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="px-6 py-12 text-center text-slate-400">
                                <div class="flex flex-col items-center justify-center">
                                    <div class="h-12 w-12 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center mb-3">
                                        <i data-lucide="calendar-x" class="w-6 h-6 text-slate-400"></i>
                                    </div>
                                    <p class="font-medium text-slate-600 dark:text-slate-300">No bookings found in this date range</p>
                                    <p class="text-xs text-slate-400 mt-1">Try selecting a different date range or reset to today.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        function formatYMD(date) {
            const y = date.getFullYear();
            const m = String(date.getMonth() + 1).padStart(2, '0');
            const d = String(date.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }

        function setPreset(type) {
            const today = new Date();
            let from = new Date();
            let to = new Date();

            if (type === 'today') {
                from = new Date(today);
                to = new Date(today);
            } else if (type === 'yesterday') {
                from = new Date(today);
                from.setDate(today.getDate() - 1);
                to = new Date(from);
            } else if (type === 'thisWeek') {
                const day = today.getDay(); // 0 is Sunday
                const diff = today.getDate() - day + (day === 0 ? -6 : 1); // Monday
                from = new Date(today.setDate(diff));
                to = new Date(from);
                to.setDate(from.getDate() + 6);
            } else if (type === 'thisMonth') {
                from = new Date(today.getFullYear(), today.getMonth(), 1);
                to = new Date(today.getFullYear(), today.getMonth() + 1, 0);
            } else if (type === 'last30') {
                from = new Date();
                from.setDate(today.getDate() - 30);
                to = new Date();
            }

            document.getElementById('fromDate').value = formatYMD(from);
            document.getElementById('toDate').value = formatYMD(to);
            document.getElementById('filterForm').submit();
        }

        document.addEventListener("DOMContentLoaded", function () {
            if (typeof lucide !== "undefined") {
                lucide.createIcons();
            }
        });
    </script>
}